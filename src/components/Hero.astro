---
import { ArrowRight, CheckCircle2, MapPin, ShieldCheck, Video } from '@lucide/astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { siteConfig, getWhatsAppUrl } from '../data/content';

const waUrl = getWhatsAppUrl(siteConfig.heroWaMessage);
---

<section id="hero" class="relative">
  <!-- 1. Dedicated Official Brand Banner (Single Banner) -->
  <div 
    id="hero-banner" 
    class="relative w-full bg-gradient-to-r from-blue-50/40 via-white to-amber-50/30 border-b border-slate-200/70 overflow-hidden flex items-center justify-center select-none"
  >
    <div class="w-full max-w-7xl mx-auto flex items-center justify-center">
      <img 
        src="/banner-hero.png" 
        alt={`${siteConfig.name} - Layanan Belanja & Jastip Pasar Grosir Jakarta`}
        class="w-full h-auto max-h-[380px] md:max-h-[440px] object-contain object-center block select-none drop-shadow-xs"
        width="2172"
        height="724"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>

  <!-- 2. Content & Explanation Section (Tepat di Bawah Banner) -->
  <div id="hero-penjelasan" class="relative py-12 sm:py-16 md:py-20 bg-slate-50/50 border-b border-slate-200/70 overflow-hidden">
    <div class="relative z-10 max-w-5xl mx-auto px-4 sm:px-6 text-center flex flex-col items-center">
      
      <!-- Context Kicker & Headline Block -->
      <div class="reveal-on-scroll flex flex-col items-center max-w-3xl">
        <!-- Editorial Service Scope Kicker (No capsule slop) -->
        <div class="flex items-center justify-center gap-2 text-xs sm:text-[13px] font-bold text-blue-700 uppercase tracking-wider mb-4">
          <MapPin class="w-4 h-4 text-blue-600 shrink-0" />
          <span>Jasa Belanja & Jastip Pasar Grosir Jakarta</span>
        </div>

        <!-- Main Headline with Solid Authoritative Deep Blue (No gradient text) -->
        <h1 class="text-2xl sm:text-3xl md:text-4xl lg:text-[42px] font-extrabold tracking-[-0.03em] text-slate-900 leading-[1.2] mb-4 sm:mb-5">
          Belanja dari Pasar Grosir Jakarta, <br class="hidden sm:inline" />
          <span class="text-blue-700">
            Tanpa Harus ke Ibu Kota.
          </span>
        </h1>

        <!-- Balanced Lead Description -->
        <p class="text-sm sm:text-base md:text-[17px] text-slate-600 leading-[1.65] font-normal mb-8 sm:mb-10 max-w-2xl mx-auto">
          Mitra Belanja carikan stok dagangan, cek harga modal asli toko, belikan, dan kirimkan kargo langsung ke kota Anda dari sentra grosir Jakarta. Cukup kirim list kebutuhan via WhatsApp.
        </p>
      </div>

      <!-- 3 Dynamic Value Cards with Standardized Rhythm -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 lg:gap-5 w-full mb-10 sm:mb-12 text-left">
        <!-- Card 1: Video Call Feature -->
        <div class="reveal-on-scroll stagger-1 card-hover-lift p-5 sm:p-6 rounded-2xl bg-white border border-slate-200/90 shadow-2xs hover:shadow-md flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class="w-10 h-10 rounded-xl bg-blue-600 text-white flex items-center justify-center shrink-0 shadow-sm shadow-blue-500/20 group-hover:scale-105 transition-transform">
                <Video class="w-5 h-5 text-white" />
              </div>
              <span class="text-[10px] font-bold uppercase tracking-wider text-blue-700 bg-blue-50 px-2 py-0.5 rounded-full border border-blue-200/60">
                Fitur Unggulan
              </span>
            </div>
            <h3 class="text-sm sm:text-[15px] font-bold text-slate-900 tracking-[-0.015em] mb-1.5 group-hover:text-blue-600 transition-colors leading-snug">
              Live Video Call Toko & Gudang
            </h3>
            <p class="text-xs sm:text-[13px] text-slate-600 leading-[1.6]">
              Lihat barang secara langsung. Tim lapangan siap Video Call WhatsApp dari toko grosir agar Anda bisa memastikan warna, motif, dan mutu fisik secara live.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-100 flex items-center text-xs font-semibold text-blue-700">
            <span>Real-time cek fisik barang</span>
          </div>
        </div>

        <!-- Card 2: Consolidation -->
        <div class="reveal-on-scroll stagger-2 card-hover-lift p-5 sm:p-6 rounded-2xl bg-white border border-slate-200/90 shadow-2xs hover:shadow-md flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class="w-10 h-10 rounded-xl bg-emerald-600 text-white flex items-center justify-center shrink-0 shadow-sm shadow-emerald-500/20 group-hover:scale-105 transition-transform">
                <CheckCircle2 class="w-5 h-5 text-white" />
              </div>
              <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-700 bg-emerald-50 px-2 py-0.5 rounded-full border border-emerald-200/60">
                Hemat Ongkir
              </span>
            </div>
            <h3 class="text-sm sm:text-[15px] font-bold text-slate-900 tracking-[-0.015em] mb-1.5 group-hover:text-emerald-600 transition-colors leading-snug">
              1 Kargo Hemat Aneka Toko
            </h3>
            <p class="text-xs sm:text-[13px] text-slate-600 leading-[1.6]">
              Bebas belanja dari puluhan toko atau sentra pasar berbeda di Jakarta. Semua barang disatukan dalam satu kargo terpadu agar biaya kirim jauh lebih hemat.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-100 flex items-center text-xs font-semibold text-emerald-700">
            <span>Packing gabungan rapi</span>
          </div>
        </div>

        <!-- Card 3: Direct Price & Shipping -->
        <div class="reveal-on-scroll stagger-3 card-hover-lift p-5 sm:p-6 rounded-2xl bg-white border border-slate-200/90 shadow-2xs hover:shadow-md flex flex-col justify-between group">
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class="w-10 h-10 rounded-xl bg-amber-500 text-white flex items-center justify-center shrink-0 shadow-sm shadow-amber-500/20 group-hover:scale-105 transition-transform">
                <ShieldCheck class="w-5 h-5 text-white" />
              </div>
              <span class="text-[10px] font-bold uppercase tracking-wider text-amber-800 bg-amber-50 px-2 py-0.5 rounded-full border border-amber-200/60">
                100% Transparan
              </span>
            </div>
            <h3 class="text-sm sm:text-[15px] font-bold text-slate-900 tracking-[-0.015em] mb-1.5 group-hover:text-amber-700 transition-colors leading-snug">
              Nota Asli & Kirim Se-Indonesia
            </h3>
            <p class="text-xs sm:text-[13px] text-slate-600 leading-[1.6]">
              Dapatkan harga modal asli tanpa markup tersembunyi. Nota fisik toko disertakan utuh di dalam kardus belanjaan Anda dan diantar ke ekspedisi kargo pilihan.
            </p>
          </div>
          <div class="mt-4 pt-3 border-t border-slate-100 flex items-center text-xs font-semibold text-amber-800">
            <span>Resi kargo langsung diinfokan</span>
          </div>
        </div>
      </div>

      <!-- Action Buttons with Refined Heights & Typography -->
      <div class="reveal-on-scroll stagger-2 flex flex-col sm:flex-row items-stretch sm:items-center justify-center gap-3 sm:gap-3.5 w-full sm:w-auto">
        <a 
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2.5 bg-[#25D366] hover:bg-[#1EBE5D] text-white px-7 sm:px-8 py-3.5 rounded-xl font-bold text-[15px] sm:text-base shadow-sm hover:shadow-md transition-all duration-200 active:scale-95 text-center group"
        >
          <WhatsAppIcon class="w-5 h-5 text-white group-hover:rotate-6 transition-transform" />
          <span>Konsultasi Belanja Sekarang</span>
        </a>

        <a 
          href="#cara-kerja"
          class="inline-flex items-center justify-center gap-2 bg-white hover:bg-slate-50 text-slate-700 hover:text-blue-600 border border-slate-300 hover:border-blue-300 px-6 py-3.5 rounded-xl font-semibold text-[15px] sm:text-base shadow-2xs hover:shadow transition-all text-center group"
        >
          <span>Lihat Alur Belanja</span>
          <ArrowRight class="w-4 h-4 text-slate-400 group-hover:text-blue-600 group-hover:translate-x-1 transition-all" />
        </a>
      </div>

      <!-- Trust Indicators: Clean Text Separation -->
      <div class="reveal-on-scroll stagger-3 mt-8 sm:mt-10 pt-6 border-t border-slate-200/80 w-full flex flex-wrap items-center justify-center gap-x-6 gap-y-2.5 text-xs sm:text-[13px] text-slate-600 font-medium">
        <div class="flex items-center gap-1.5">
          <ShieldCheck class="w-4 h-4 text-blue-600 shrink-0" />
          <span>Nota Asli dari Toko</span>
        </div>
        <span class="hidden sm:inline text-slate-300">&bull;</span>
        <div class="flex items-center gap-1.5">
          <Video class="w-4 h-4 text-emerald-600 shrink-0" />
          <span>Update Foto & Live Video Call</span>
        </div>
        <span class="hidden sm:inline text-slate-300">&bull;</span>
        <div class="flex items-center gap-1.5">
          <CheckCircle2 class="w-4 h-4 text-amber-600 shrink-0" />
          <span>Konsolidasi Paket Kargo Aman</span>
        </div>
      </div>

    </div>
  </div>
</section>
