---
import { ArrowRight, CheckCircle2, ShieldCheck, Video } from '@lucide/astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { siteConfig, getWhatsAppUrl } from '../data/content';

const waUrl = getWhatsAppUrl(siteConfig.heroWaMessage);
---

<section id="hero" class="relative">
  <!-- 1. Dedicated Official Brand Banner (Single Banner) -->
  <div 
    id="hero-banner" 
    class="relative w-full bg-gradient-to-r from-blue-50/40 via-white to-amber-50/30 border-b border-slate-200/70 overflow-hidden flex items-center justify-center select-none"
  >
    <div class="w-full max-w-7xl mx-auto flex items-center justify-center">
      <img 
        src="/banner-hero.png" 
        alt={`${siteConfig.name} - Layanan Belanja & Jastip Pasar Grosir Jakarta`}
        class="w-full h-auto max-h-[380px] md:max-h-[440px] object-contain object-center block select-none drop-shadow-xs"
        width="2172"
        height="724"
        loading="eager"
        fetchpriority="high"
      />
    </div>
  </div>

  <!-- 2. Content & Human Showcase Section (Split Layout) -->
  <div id="hero-penjelasan" class="relative pt-10 sm:pt-14 md:pt-18 pb-8 sm:pb-12 md:pb-14 bg-gradient-to-b from-orange-50/60 via-amber-50/30 to-white overflow-hidden">
    <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
      
      <!-- Split Hero Grid: Content (Left) & Human Showcase (Right) -->
      <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-12 items-center mb-12 sm:mb-16">
        
        <!-- Left Column: Copy & Actions (7 cols) -->
        <div class="lg:col-span-7 flex flex-col items-center lg:items-start text-center lg:text-left reveal-on-scroll">
          
          <!-- Main Headline in Outfit font -->
          <h1 class="font-heading text-3xl sm:text-4xl md:text-5xl lg:text-[46px] font-extrabold tracking-[-0.03em] text-slate-900 leading-[1.15] mb-4 sm:mb-5">
            Belanja di Pasar Grosir Jakarta, <br class="hidden sm:inline" />
            <span class="text-blue-700">
              Tanpa Harus ke Jakarta.
            </span>
          </h1>

          <!-- Balanced Lead Description -->
          <div class="mb-7 sm:mb-8 max-w-2xl space-y-3">
            <p class="text-sm sm:text-base md:text-[17px] text-slate-700 leading-[1.7] font-medium">
              Khusus untuk Anda <strong class="font-extrabold text-orange-600">para pedagang</strong> di berbagai daerah, kami hadir untuk memudahkan urusan perbelanjaan usaha Anda di pusat grosir, supplier, gudang dan pabrik Jakarta.
            </p>
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-xl bg-orange-50 border border-orange-200 shadow-2xs">
              <span class="w-2 h-2 rounded-full bg-orange-500 animate-pulse"></span>
              <span class="text-xs sm:text-sm font-black text-orange-600 uppercase tracking-wide">&ldquo;BELANJA MUDAH DAN AMAN TERJAMIN&rdquo;</span>
            </div>
          </div>

          <!-- Action Buttons -->
          <div class="flex flex-col sm:flex-row items-stretch sm:items-center justify-center lg:justify-start gap-3 sm:gap-3.5 w-full sm:w-auto mb-8">
            <a 
              href={waUrl}
              target="_blank"
              rel="noopener noreferrer"
              class="inline-flex items-center justify-center gap-2.5 bg-[#25D366] hover:bg-[#1EBE5D] text-white px-7 sm:px-8 py-3.5 rounded-xl font-bold text-[15px] sm:text-base shadow-sm hover:shadow-md transition-all duration-200 active:scale-95 text-center group"
            >
              <WhatsAppIcon class="w-5 h-5 text-white group-hover:rotate-6 transition-transform" />
              <span>Kirim List Belanja via WhatsApp</span>
            </a>

            <a 
              href="#cara-kerja"
              class="inline-flex items-center justify-center gap-2 bg-white hover:bg-slate-50 text-slate-700 hover:text-blue-600 border border-slate-300 hover:border-blue-300 px-6 py-3.5 rounded-xl font-semibold text-[15px] sm:text-base shadow-2xs hover:shadow transition-all text-center group"
            >
              <span>Lihat Alur Cara Kerja</span>
              <ArrowRight class="w-4 h-4 text-slate-400 group-hover:text-blue-600 group-hover:translate-x-1 transition-all" />
            </a>
          </div>

          <!-- Trust Indicators -->
          <div class="w-full flex flex-wrap items-center justify-center lg:justify-start gap-x-5 gap-y-2 text-xs sm:text-[13px] text-slate-700 font-semibold pt-5 border-t border-slate-200/80">
            <div class="flex items-center gap-1.5">
              <ShieldCheck class="w-4 h-4 text-blue-600 shrink-0" />
              <span>Nota Asli Toko (0% Markup)</span>
            </div>
            <span class="hidden sm:inline text-slate-300">&bull;</span>
            <div class="flex items-center gap-1.5">
              <Video class="w-4 h-4 text-emerald-600 shrink-0" />
              <span>Live Video Call dari Toko</span>
            </div>
            <span class="hidden sm:inline text-slate-300">&bull;</span>
            <div class="flex items-center gap-1.5">
              <CheckCircle2 class="w-4 h-4 text-amber-600 shrink-0" />
              <span>Gabung Banyak Toko Jadi 1 Kargo</span>
            </div>
          </div>

        </div>

        <!-- Right Column: Interactive Transparent Human Shopper Showcase (5 cols) -->
        <div class="lg:col-span-5 flex justify-center items-center reveal-on-scroll stagger-2">
          <div class="relative w-full max-w-[380px] sm:max-w-[430px] flex flex-col items-center justify-center">
            
            <!-- Soft Ambient Backlight & Pedestal (Subtle & Clean) -->
            <div class="absolute w-64 h-64 sm:w-80 sm:h-80 rounded-full bg-gradient-to-tr from-blue-200/40 via-indigo-100/30 to-amber-100/30 blur-2xl pointer-events-none -z-0"></div>
            
            <!-- Soft Floor Shadow for Grounded Realism -->
            <div class="absolute bottom-3 w-52 sm:w-64 h-5 rounded-full bg-slate-900/10 blur-md pointer-events-none z-0"></div>

            <!-- Top Indicator Pill -->
            <div class="inline-flex items-center gap-2 px-3.5 py-1.5 rounded-full bg-white/95 backdrop-blur-md border border-slate-200/90 text-slate-800 text-xs font-bold shadow-xs mb-2 z-20">
              <span class="inline-flex rounded-full h-2.5 w-2.5 bg-emerald-500"></span>
              <span>Personal Shopper Siaga di Sentra Niaga</span>
            </div>

            <!-- Transparent Cutout Human Shopper with Silky Smooth Floating Animation -->
            <div class="relative z-10 flex items-center justify-center animate-shopper-float my-2">
              <img 
                src="/image-manusia-v1.png" 
                alt="Personal Shopper PT Mitra Belanja Jakarta"
                class="w-auto h-[330px] sm:h-[380px] md:h-[420px] object-contain drop-shadow-[0_16px_28px_rgba(15,23,42,0.18)] select-none pointer-events-none"
                width="1254"
                height="1254"
                loading="eager"
              />
            </div>

            <!-- Floating Tactile Badge 1: Live Video Call (Left) - Positioned at torso level to NEVER cover face -->
            <div class="absolute bottom-24 -left-1 sm:-left-5 lg:-left-7 z-20 animate-float-slow">
              <div class="flex items-center gap-2.5 px-3.5 py-2.5 rounded-2xl bg-white/95 backdrop-blur-md text-slate-900 shadow-xl border border-slate-100/90 text-xs font-bold">
                <div class="w-8 h-8 rounded-xl bg-emerald-500 text-white flex items-center justify-center shadow-xs">
                  <Video class="w-4 h-4 text-white" />
                </div>
                <div class="text-left">
                  <span class="block text-[10px] text-slate-400 font-semibold uppercase tracking-wider">Cek Langsung</span>
                  <span class="text-xs text-slate-900 font-bold">Live Video Call Toko</span>
                </div>
              </div>
            </div>

            <!-- Floating Tactile Badge 2: Nota Asli Fisik (Right) - Positioned at box level -->
            <div class="absolute bottom-6 -right-1 sm:-right-5 lg:-right-7 z-20">
              <div class="flex items-center gap-2.5 px-3.5 py-2.5 rounded-2xl bg-white/95 backdrop-blur-md text-slate-900 shadow-xl border border-slate-100/90 text-xs font-bold">
                <div class="w-8 h-8 rounded-xl bg-blue-600 text-white flex items-center justify-center shadow-xs">
                  <ShieldCheck class="w-4 h-4 text-white" />
                </div>
                <div class="text-left">
                  <span class="block text-[10px] text-slate-400 font-semibold uppercase tracking-wider">Harga Modal</span>
                  <span class="text-xs text-slate-900 font-bold">Nota Asli Disertakan</span>
                </div>
              </div>
            </div>

          </div>
        </div>

      </div>

      <!-- 3 Distinct Quantitative Benefit Benchmark Cards (Architectural Triptych Sculpted Silhouettes) -->
      <div class="grid grid-cols-1 sm:grid-cols-3 gap-4 lg:gap-5 w-full mb-12 sm:mb-16 text-left">
        <!-- Card 1: Left Triptych Wing (Diagonal Opposing Radii Silhouette) -->
        <div class="reveal-on-scroll stagger-1 card-hover-lift p-5 sm:p-6 rounded-tl-[2.75rem] rounded-br-[2.75rem] rounded-tr-xl rounded-bl-xl bg-white border border-blue-200/90 shadow-2xs hover:shadow-md flex flex-col justify-between group relative overflow-hidden">
          <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-blue-500 to-indigo-600"></div>
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class="flex items-center gap-2.5">
                <div class="w-10 h-10 rounded-xl bg-blue-600 text-white flex items-center justify-center shrink-0 shadow-xs shadow-blue-500/25 group-hover:scale-105 transition-transform duration-300">
                  <Video class="w-5 h-5 text-white" />
                </div>
                <span class="text-[10px] font-bold uppercase tracking-wider text-blue-700 bg-blue-50 border border-blue-200/70 px-2 py-0.5 rounded-md">
                  Real-Time Visual
                </span>
              </div>
              <span class="text-[11px] font-extrabold text-blue-700 bg-blue-100/70 px-2 py-0.5 rounded-md">
                100% Valid
              </span>
            </div>
            
            <h3 class="font-heading text-base sm:text-lg font-bold text-slate-900 tracking-[-0.015em] mb-1.5 group-hover:text-blue-600 transition-colors leading-snug">
              Live Video Call Toko
            </h3>
            <p class="text-xs sm:text-[13.5px] text-slate-700 leading-relaxed font-medium">
              Cek serat kain, warna, dan fisik barang secara langsung via video call WhatsApp sebelum membayar.
            </p>
          </div>

          <!-- Tactile Benchmark Indicator -->
          <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-blue-700">
            <span class="flex items-center gap-1.5">
              <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
              <span>Cek fisik sebelum bayar</span>
            </span>
            <span class="text-[11px] font-mono text-slate-400">HD Live</span>
          </div>
        </div>

        <!-- Card 2: Center Triptych Arch (Cathedral Dome / Top Arch Silhouette) -->
        <div class="reveal-on-scroll stagger-2 card-hover-lift p-5 sm:p-6 rounded-t-[2.75rem] rounded-b-xl bg-white border border-emerald-200/90 shadow-2xs hover:shadow-md flex flex-col justify-between group relative overflow-hidden">
          <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-emerald-500 to-teal-600"></div>
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class="flex items-center gap-2.5">
                <div class="w-10 h-10 rounded-xl bg-emerald-600 text-white flex items-center justify-center shrink-0 shadow-xs shadow-emerald-500/25 group-hover:scale-105 transition-transform duration-300">
                  <CheckCircle2 class="w-5 h-5 text-white" />
                </div>
                <span class="text-[10px] font-bold uppercase tracking-wider text-emerald-800 bg-emerald-50 border border-emerald-200/70 px-2 py-0.5 rounded-md">
                  Efisiensi Logistik
                </span>
              </div>
              <span class="text-[11px] font-extrabold text-emerald-800 bg-emerald-100/70 px-2 py-0.5 rounded-md">
                Hemat s.d 60%
              </span>
            </div>
            
            <h3 class="font-heading text-base sm:text-lg font-bold text-slate-900 tracking-[-0.015em] mb-1.5 group-hover:text-emerald-700 transition-colors leading-snug">
              1 Kargo Terpadu
            </h3>
            <p class="text-xs sm:text-[13.5px] text-slate-700 leading-relaxed font-medium">
              Belanja dari aneka pasar grosir disatukan dalam satu paket packing untuk menghemat biaya kirim.
            </p>
          </div>

          <!-- Tactile Benchmark Indicator -->
          <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-emerald-700">
            <span class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
              <span>Banyak Toko ke 1 Kargo</span>
            </span>
            <span class="text-[11px] font-mono text-slate-400">1 Resi</span>
          </div>
        </div>

        <!-- Card 3: Right Triptych Wing (Mirrored Diagonal Opposing Radii Silhouette) -->
        <div class="reveal-on-scroll stagger-3 card-hover-lift p-5 sm:p-6 rounded-tr-[2.75rem] rounded-bl-[2.75rem] rounded-tl-xl rounded-br-xl bg-white border border-amber-200/90 shadow-2xs hover:shadow-md flex flex-col justify-between group relative overflow-hidden">
          <div class="absolute top-0 left-0 right-0 h-1 bg-gradient-to-r from-amber-400 to-amber-600"></div>
          <div>
            <div class="flex items-center justify-between mb-4">
              <div class="flex items-center gap-2.5">
                <div class="w-10 h-10 rounded-xl bg-amber-500 text-white flex items-center justify-center shrink-0 shadow-xs shadow-amber-500/25 group-hover:scale-105 transition-transform duration-300">
                  <ShieldCheck class="w-5 h-5 text-white" />
                </div>
                <span class="text-[10px] font-bold uppercase tracking-wider text-amber-800 bg-amber-50 border border-amber-200/70 px-2 py-0.5 rounded-md">
                  Transparansi Bon
                </span>
              </div>
              <span class="text-[11px] font-extrabold text-amber-900 bg-amber-100/80 px-2 py-0.5 rounded-md">
                0% Markup
              </span>
            </div>
            
            <h3 class="font-heading text-base sm:text-lg font-bold text-slate-900 tracking-[-0.015em] mb-1.5 group-hover:text-amber-700 transition-colors leading-snug">
              Nota Pembelian Asli
            </h3>
            <p class="text-xs sm:text-[13.5px] text-slate-700 leading-relaxed font-medium">
              Tanpa biaya modal terselubung. Bon fisik asli dari toko disertakan langsung di dalam dus kiriman.
            </p>
          </div>

          <!-- Tactile Benchmark Indicator -->
          <div class="mt-4 pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-amber-800">
            <span class="flex items-center gap-1.5">
              <span class="w-1.5 h-1.5 rounded-full bg-amber-600"></span>
              <span>Nota fisik toko disertakan utuh</span>
            </span>
            <span class="text-[11px] font-mono text-slate-400">Resi Langsung</span>
          </div>
        </div>
      </div>

    </div>

  </div>
</section>
