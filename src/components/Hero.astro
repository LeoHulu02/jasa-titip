---
import { ArrowRight, CheckCircle2, MapPin, ShieldCheck, ShoppingCart } from '@lucide/astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { siteConfig, getWhatsAppUrl } from '../data/content';

const waUrl = getWhatsAppUrl(siteConfig.heroWaMessage);
---


<section id="hero" class="relative overflow-hidden pt-8 pb-14 sm:py-16 md:py-20 lg:py-24 bg-gradient-to-b from-slate-50 via-white to-white border-b border-slate-100">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-10 lg:gap-12 items-center">
      
      <!-- Left Column: Copy & CTAs (7 cols on desktop) -->
      <div class="lg:col-span-7 flex flex-col items-start text-left">
        
        <!-- Context Badge -->
        <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue-50 border border-blue-200/80 text-blue-700 text-xs font-semibold mb-6">
          <MapPin class="w-3.5 h-3.5 text-blue-600" />
          <span>Jasa Belanja & Jastip Pasar Grosir Jakarta</span>
        </div>

        <!-- Main Headline -->
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold tracking-tight text-slate-900 leading-[1.18] mb-5">
          Belanja dari Pasar Grosir Jakarta, <br class="hidden sm:inline" />
          <span class="text-blue-600">Tanpa Harus ke Ibu Kota.</span>
        </h1>

        <!-- Subheadline -->
        <p class="text-base sm:text-lg text-slate-600 leading-relaxed mb-8 max-w-2xl font-normal">
          Mitra Belanja bantu carikan barang dagangan, cek harga modal toko, belikan, dan kirimkan langsung ke kota Anda dari berbagai sentra pasar grosir Jakarta. Cukup konsultasikan kebutuhan Anda via WhatsApp.
        </p>

        <!-- Value Bullet Points -->
        <div class="space-y-3 mb-8 w-full max-w-lg">
          <div class="flex items-start gap-3">
            <CheckCircle2 class="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" />
            <span class="text-sm sm:text-base text-slate-700 font-medium">
              Bisa belanja aneka barang dari berbagai toko dalam 1 kargo hemat
            </span>
          </div>
          <div class="flex items-start gap-3">
            <CheckCircle2 class="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" />
            <span class="text-sm sm:text-base text-slate-700 font-medium">
              Cek harga modal asli dan foto stok seri langsung di kios pedagang
            </span>
          </div>
          <div class="flex items-start gap-3">
            <CheckCircle2 class="w-5 h-5 text-emerald-600 shrink-0 mt-0.5" />
            <span class="text-sm sm:text-base text-slate-700 font-medium">
              Kirim via kargo murah & cepat ke seluruh wilayah Indonesia
            </span>
          </div>
        </div>

        <!-- CTA Buttons Group -->
        <div class="flex flex-col sm:flex-row items-stretch sm:items-center gap-3.5 w-full sm:w-auto">
          <a 
            href={waUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex items-center justify-center gap-2.5 bg-[#25D366] hover:bg-[#1EBE5D] text-white px-6 py-3.5 rounded font-bold text-base shadow-sm hover:shadow-md transition-all active:scale-98 text-center"
          >
            <WhatsAppIcon class="w-5 h-5 text-white" />
            <span>Konsultasi Belanja via WhatsApp</span>
          </a>

          <a 
            href="#cara-kerja"
            class="inline-flex items-center justify-center gap-2 bg-white hover:bg-slate-50 text-slate-700 hover:text-slate-900 border border-slate-300 px-6 py-3.5 rounded font-semibold text-base transition-colors text-center"
          >
            <span>Lihat Alur Belanja</span>
            <ArrowRight class="w-4 h-4 text-slate-400" />
          </a>
        </div>

        <!-- Trust Mini-Notes -->
        <div class="mt-8 pt-6 border-t border-slate-200/80 flex flex-wrap items-center gap-y-2 gap-x-6 text-xs text-slate-500">
          <div class="flex items-center gap-1.5 font-medium">
            <ShieldCheck class="w-4 h-4 text-blue-600" />
            <span>Nota Asli dari Toko</span>
          </div>
          <div class="flex items-center gap-1.5 font-medium">
            <span class="w-1.5 h-1.5 rounded-full bg-slate-300"></span>
            <span>Update Foto Stok Nyata</span>
          </div>
          <div class="flex items-center gap-1.5 font-medium">
            <span class="w-1.5 h-1.5 rounded-full bg-slate-300"></span>
            <span>Konsolidasi Paket Hemat</span>
          </div>
        </div>

      </div>

      <!-- Right Column: Authentic Photography (5 cols on desktop) -->
      <div class="lg:col-span-5 relative mt-4 lg:mt-0">
        <div class="relative rounded-lg overflow-hidden border border-slate-200 shadow-sm bg-slate-100">
          <img 
            src="/images/tanah-abang-hero.jpg" 
            alt="Suasana nyata pusat grosir perdagangan di Jakarta"
            class="w-full h-[320px] sm:h-[400px] lg:h-[460px] object-cover object-center transform hover:scale-102 transition-transform duration-500"
            width="600"
            height="460"
            loading="eager"
          />
          <div class="absolute bottom-0 inset-x-0 bg-gradient-to-t from-slate-900/85 via-slate-900/40 to-transparent p-4 sm:p-5 text-white">
            <div class="flex items-center justify-between">
              <div>
                <p class="text-xs uppercase tracking-wider text-slate-300 font-semibold mb-0.5">
                  Dokumentasi Lapangan
                </p>
                <p class="text-sm font-bold text-white">
                  Pusat Perdagangan Grosir Terlengkap
                </p>
              </div>
              <span class="text-[11px] bg-white/20 backdrop-blur-xs px-2.5 py-1 rounded text-white font-medium">
                Seluruh Jakarta
              </span>
            </div>
          </div>
        </div>
      </div>

    </div>
  </div>
</section>
