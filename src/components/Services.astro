---
import { Search, Tag, Layers, CheckCheck, Truck, Users, ArrowUpRight } from '@lucide/astro';
import { services } from '../data/content';

const serviceVisuals = [
  {
    icon: Search,
    bgBadge: 'bg-blue-50 text-blue-700 border-blue-200',
    iconBg: 'bg-blue-600 text-white shadow-blue-500/20',
    hoverBorder: 'group-hover:border-blue-300'
  },
  {
    icon: Tag,
    bgBadge: 'bg-emerald-50 text-emerald-700 border-emerald-200',
    iconBg: 'bg-emerald-600 text-white shadow-emerald-500/20',
    hoverBorder: 'group-hover:border-emerald-300'
  },
  {
    icon: Layers,
    bgBadge: 'bg-blue-50 text-blue-700 border-blue-200',
    iconBg: 'bg-blue-700 text-white shadow-blue-600/20',
    hoverBorder: 'group-hover:border-blue-300'
  },
  {
    icon: CheckCheck,
    bgBadge: 'bg-slate-100 text-slate-700 border-slate-200',
    iconBg: 'bg-slate-800 text-white shadow-slate-700/20',
    hoverBorder: 'group-hover:border-slate-400'
  },
  {
    icon: Truck,
    bgBadge: 'bg-amber-50 text-amber-800 border-amber-200',
    iconBg: 'bg-amber-500 text-white shadow-amber-500/20',
    hoverBorder: 'group-hover:border-amber-300'
  },
  {
    icon: Users,
    bgBadge: 'bg-blue-50 text-blue-700 border-blue-200',
    iconBg: 'bg-blue-600 text-white shadow-blue-500/20',
    hoverBorder: 'group-hover:border-blue-300'
  }
];
---

<section id="layanan" class="py-14 sm:py-18 md:py-22 bg-white border-b border-slate-100 relative">
  <div class="relative z-10 max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-2xl mx-auto text-center mb-10 sm:mb-12 md:mb-14 reveal-on-scroll">
      <p class="text-xs font-bold uppercase tracking-wider text-blue-700 mb-2.5">
        Layanan Lapangan Terpadu
      </p>
      <h2 class="text-2xl sm:text-3xl md:text-[32px] lg:text-[34px] font-extrabold text-slate-900 tracking-[-0.025em] leading-[1.25] mb-3">
        Apa yang Bisa Kami Bantu di Pasar Grosir Jakarta?
      </h2>
      <p class="text-sm sm:text-base md:text-[16.5px] text-slate-600 leading-[1.65] font-normal max-w-xl sm:max-w-2xl mx-auto">
        Solusi belanja menyeluruh dari penyusuran sentra grosir, negosiasi harga modal, hingga kargo tiba di toko Anda.
      </p>
    </div>

    <!-- Lively 6-Card Interactive Grid (1 col mobile, 2 col tablet, 3 col desktop) -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5 lg:gap-6">
      {services.map((item, index) => {
        const visual = serviceVisuals[index] || serviceVisuals[0];
        const IconComponent = visual.icon;
        const staggerClass = `stagger-${(index % 4) + 1}`;

        return (
          <div 
            class={`p-5 sm:p-6 lg:p-7 rounded-2xl bg-white border border-slate-200/90 shadow-2xs hover:shadow-md transition-all duration-300 card-hover-lift flex flex-col justify-between group ${visual.hoverBorder} reveal-on-scroll ${staggerClass}`}
          >
            <div>
              <!-- Top Row: Icon + Number & Tag -->
              <div class="flex items-center justify-between mb-4 sm:mb-5">
                <div class={`w-11 h-11 sm:w-12 sm:h-12 rounded-xl flex items-center justify-center shadow-xs ${visual.iconBg} group-hover:scale-105 transition-transform duration-300`}>
                  <IconComponent class="w-5 h-5 sm:w-6 sm:h-6" />
                </div>
                <div class="flex items-center gap-2">
                  <span class={`text-[10.5px] sm:text-[11px] font-bold px-2.5 py-0.5 rounded-md border ${visual.bgBadge}`}>
                    {item.tag}
                  </span>
                  <span class="text-xs font-semibold text-slate-400 group-hover:text-slate-600 transition-colors">
                    0{index + 1}
                  </span>
                </div>
              </div>

              <!-- Title & Description -->
              <h3 class="text-base sm:text-lg font-bold text-slate-900 tracking-[-0.015em] mb-2 group-hover:text-blue-600 transition-colors leading-snug">
                {item.title}
              </h3>
              <p class="text-xs sm:text-[13.5px] text-slate-600 leading-[1.6] font-normal">
                {item.description}
              </p>
            </div>

            <!-- Bottom Interactive Detail Pill -->
            <div class="mt-5 pt-3.5 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-slate-500 group-hover:text-blue-600 transition-colors">
              <span>Siap ditangani tim lapangan</span>
              <ArrowUpRight class="w-4 h-4 opacity-40 group-hover:opacity-100 group-hover:translate-x-0.5 group-hover:-translate-y-0.5 transition-all" />
            </div>
          </div>
        );
      })}
    </div>

  </div>
</section>
