---
import { Search, Tag, Layers, CheckCheck, Truck, Users, CheckCircle2, ShieldCheck, Video, Package } from '@lucide/astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { services, getWhatsAppUrl } from '../data/content';

const serviceVisuals = [
  {
    icon: Search,
    bgBadge: 'bg-blue-50 text-blue-700 border-blue-200',
    iconBg: 'bg-blue-600 text-white shadow-blue-500/20',
    hoverBorder: 'group-hover:border-blue-400'
  },
  {
    icon: Tag,
    bgBadge: 'bg-emerald-50 text-emerald-700 border-emerald-200',
    iconBg: 'bg-emerald-600 text-white shadow-emerald-500/20',
    hoverBorder: 'group-hover:border-emerald-400'
  },
  {
    icon: Layers,
    bgBadge: 'bg-blue-50 text-blue-700 border-blue-200',
    iconBg: 'bg-blue-700 text-white shadow-blue-600/20',
    hoverBorder: 'group-hover:border-blue-400'
  },
  {
    icon: CheckCheck,
    bgBadge: 'bg-slate-100 text-slate-700 border-slate-200',
    iconBg: 'bg-slate-800 text-white shadow-slate-700/20',
    hoverBorder: 'group-hover:border-slate-500'
  },
  {
    icon: Truck,
    bgBadge: 'bg-amber-50 text-amber-800 border-amber-200',
    iconBg: 'bg-amber-500 text-white shadow-amber-500/20',
    hoverBorder: 'group-hover:border-amber-400'
  },
  {
    icon: Users,
    bgBadge: 'bg-blue-50 text-blue-700 border-blue-200',
    iconBg: 'bg-blue-600 text-white shadow-blue-500/20',
    hoverBorder: 'group-hover:border-blue-400'
  }
];

const waLayananUrl = getWhatsAppUrl('Halo Tim Lapangan Mitra Belanja, saya ingin konsultasi layanan belanja dan pengurusan kargo grosir di Jakarta.');
---

<section id="layanan" class="pt-0 pb-0 bg-gradient-to-b from-orange-100/80 via-amber-50 to-orange-50/90 relative overflow-hidden">
  <!-- Cool Orange Tactical Dot Grid Pattern -->
  <div 
    class="absolute inset-0 pointer-events-none opacity-[0.35]"
    style="background-image: radial-gradient(rgba(234, 88, 12, 0.18) 1.5px, transparent 1.5px); background-size: 26px 26px;"
    aria-hidden="true"
  ></div>

  <!-- Top Asymmetric Wave Divider: Seamless Transition from Hero into Layanan -->
  <div class="relative w-full overflow-hidden leading-none z-20 -mt-px pointer-events-none mb-6 sm:mb-10">
    <svg 
      class="relative block w-full h-14 sm:h-18 md:h-22" 
      viewBox="0 0 1200 120" 
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <!-- Top white fill masking everything above the curve with Hero's white background -->
      <path 
        d="M0,0 L1200,0 L1200,115 Q900,94 600,82 Q300,70 0,35 Z" 
        fill="#FFFFFF"
      ></path>

      <!-- Primary velocity contour stroke -->
      <path 
        d="M0,35 Q300,70 600,82 T1200,115" 
        fill="none" 
        stroke="#EA580C" 
        stroke-width="3" 
        stroke-linecap="round"
      ></path>

      <!-- Secondary floating dashed speed line -->
      <path 
        d="M0,22 Q300,57 600,69 T1200,102" 
        fill="none" 
        stroke="#FB923C" 
        stroke-width="1.5" 
        stroke-dasharray="8 6" 
        stroke-opacity="0.6"
      ></path>
    </svg>
  </div>

  <!-- Distinct Dynamic Ambient Orbs -->
  <div class="absolute -top-24 -left-24 w-96 h-96 rounded-full bg-orange-300/25 blur-[100px] pointer-events-none"></div>
  <div class="absolute top-1/2 -right-24 w-96 h-96 rounded-full bg-amber-300/30 blur-[100px] pointer-events-none"></div>
  <div class="absolute bottom-10 left-1/3 w-[500px] h-48 rounded-full bg-orange-200/20 blur-[110px] pointer-events-none"></div>

  <div class="relative z-10 max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    
    <!-- Section Header -->
    <div class="max-w-2xl mx-auto text-center mb-12 sm:mb-16 reveal-on-scroll">
      <p class="text-xs font-bold uppercase tracking-wider text-blue-700 mb-2.5">
        Layanan Lapangan Terpadu
      </p>
      <h2 class="font-heading text-2xl sm:text-3xl md:text-[34px] font-extrabold text-slate-900 tracking-[-0.025em] leading-[1.25] mb-3">
        Layanan Belanja & Logistik Lapangan Kami
      </h2>
      <p class="text-sm sm:text-base md:text-[16.5px] text-slate-700 leading-[1.65] font-medium max-w-xl sm:max-w-2xl mx-auto">
        Pendampingan lengkap dari penyusuran lorong toko, tawar harga modal, hingga kargo meluncur ke kota Anda.
      </p>
    </div>

    <!-- Asymmetric Split: Team Showcase (Left) vs 6 Services (Right) -->
    <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:gap-10 items-start mb-14 sm:mb-20">
      
      <!-- Left Column: Team Image Showcase Card (5 cols) (Sculpted Diagonal Silhouette) -->
      <div class="lg:col-span-5 lg:sticky lg:top-24 reveal-on-scroll">
        <div class="rounded-tl-[3.5rem] rounded-br-[3.5rem] rounded-tr-xl rounded-bl-xl bg-white border border-slate-200/90 shadow-md p-6 sm:p-7 overflow-hidden relative group">
          
          <!-- Subtle Accent Pattern -->
          <div class="absolute -right-12 -top-12 w-48 h-48 bg-blue-50 rounded-full blur-2xl pointer-events-none"></div>

          <!-- Status Pill -->
          <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-emerald-50 border border-emerald-200 text-emerald-800 text-xs font-bold mb-4 shadow-2xs">
            <span class="inline-flex rounded-full h-2 w-2 bg-emerald-500"></span>
            <span>Tim Ekspedisi & Belanja Lapangan</span>
          </div>

          <h3 class="font-heading text-xl sm:text-2xl font-bold text-slate-900 leading-snug mb-2">
            Hadir Langsung di Lokasi Toko & Gudang
          </h3>
          <p class="text-xs sm:text-sm text-slate-700 leading-relaxed font-medium mb-6">
            Tim kami hadir langsung di lorong pasar. Kami cek stok, angkat barang, bungkus karung packing, hingga antar ke kargo pilihan Anda.
          </p>

          <!-- Transparent Team Stage Showcase (Open, Heroic, Crisp & Prominent) -->
          <div class="relative w-full flex flex-col items-center justify-center pt-2 pb-6 my-2">
            <!-- Soft Ambient Backlight Halo -->
            <div class="absolute w-64 h-64 sm:w-72 sm:h-72 rounded-full bg-gradient-to-tr from-emerald-100/60 via-blue-100/50 to-amber-100/30 blur-2xl pointer-events-none"></div>
            
            <!-- Soft Floor Shadow for Grounded Realism -->
            <div class="absolute bottom-6 w-52 sm:w-64 h-4 rounded-full bg-slate-900/10 blur-md pointer-events-none"></div>

            <!-- Transparent Cutout Team (Scaled to Full Heroic Prominence) -->
            <div class="relative z-10 flex items-center justify-center group-hover:scale-102 transition-transform duration-500">
              <img 
                src="/image-team-v2.png" 
                alt="Tim Ekspedisi dan Personal Shopper Mitra Belanja Jakarta"
                class="w-auto h-[260px] sm:h-[300px] md:h-[320px] max-w-full object-contain drop-shadow-[0_16px_28px_rgba(15,23,42,0.18)] select-none pointer-events-none"
                width="1277"
                height="1231"
                loading="eager"
              />
            </div>

            <!-- Floating Micro-Badge Left - Positioned at bottom to avoid covering faces -->
            <div class="absolute bottom-4 -left-1 sm:-left-3 z-20">
              <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/95 backdrop-blur-md text-slate-800 shadow-md border border-slate-200/80 text-[11px] font-bold">
                <span class="w-2 h-2 rounded-full bg-emerald-500"></span>
                <span>Siaga di Semua Pasar Grosir Jakarta</span>
              </div>
            </div>

            <!-- Floating Micro-Badge Right - Positioned at bottom right to avoid covering faces -->
            <div class="absolute bottom-12 -right-1 sm:-right-2 z-20">
              <div class="flex items-center gap-1.5 px-3 py-1.5 rounded-full bg-white/95 backdrop-blur-md text-slate-800 shadow-md border border-slate-200/80 text-[11px] font-bold">
                <Package class="w-3.5 h-3.5 text-blue-600" />
                <span>Packing & Kargo</span>
              </div>
            </div>
          </div>

          <!-- Proof Checklist -->
          <div class="space-y-2.5 text-xs sm:text-sm font-medium text-slate-700 mb-6">
            <div class="flex items-center gap-2">
              <CheckCircle2 class="w-4 h-4 text-emerald-600 shrink-0" />
              <span>Gabung belanjaan dari aneka toko jadi 1 paket kargo</span>
            </div>
            <div class="flex items-center gap-2">
              <CheckCircle2 class="w-4 h-4 text-emerald-600 shrink-0" />
              <span>Nota fisik toko asli disertakan utuh tanpa markup modal</span>
            </div>
            <div class="flex items-center gap-2">
              <CheckCircle2 class="w-4 h-4 text-emerald-600 shrink-0" />
              <span>Konfirmasi foto dan video call sebelum barang dibungkus</span>
            </div>
          </div>

          <a 
            href={waLayananUrl}
            target="_blank"
            rel="noopener noreferrer"
            class="w-full inline-flex items-center justify-center gap-2 bg-[#25D366] hover:bg-[#1EBE5D] text-white px-6 py-3.5 rounded-xl text-sm font-bold shadow-xs hover:shadow-md transition-all active:scale-95 group"
          >
            <WhatsAppIcon class="w-4 h-4 text-white group-hover:rotate-6 transition-transform" />
            <span>Hubungi Tim Lapangan Sekarang</span>
          </a>

        </div>
      </div>

      <!-- Right Column: 6 Field Operational Spec Cards (7 cols) with Distinct Tabbed Corner Silhouettes -->
      <div class="lg:col-span-7 grid grid-cols-1 sm:grid-cols-2 gap-4 sm:gap-5">
        {services.map((item, index) => {
          const visual = serviceVisuals[index] || serviceVisuals[0];
          const IconComponent = visual.icon;
          const staggerClass = `stagger-${(index % 4) + 1}`;
          
          // Industrial tabbed corner silhouettes
          const serviceShapes = [
            'rounded-tr-[3rem] rounded-tl-xl rounded-b-xl',  // Ops 1: Top-Right tab
            'rounded-tl-[3rem] rounded-tr-xl rounded-b-xl',  // Ops 2: Top-Left tab
            'rounded-br-[3rem] rounded-t-xl rounded-bl-xl',  // Ops 3: Bottom-Right notch
            'rounded-bl-[3rem] rounded-t-xl rounded-br-xl',  // Ops 4: Bottom-Left notch
            'rounded-tr-[3rem] rounded-tl-xl rounded-b-xl',  // Ops 5: Top-Right tab
            'rounded-tl-[3rem] rounded-tr-xl rounded-b-xl',  // Ops 6: Top-Left tab
          ];
          const shapeClass = serviceShapes[index] || 'rounded-2xl';

          const protocols = [
            { code: 'OPS #01', guarantee: 'Sourcing Toko Fisik Termurah' },
            { code: 'OPS #02', guarantee: 'Live Video Call Cek Mutu' },
            { code: 'OPS #03', guarantee: '1 Kargo Hemat Multi Toko' },
            { code: 'OPS #04', guarantee: 'QC Kelayakan & Jumlah Nota' },
            { code: 'OPS #05', guarantee: 'Packing Segel & Antar Kargo' },
            { code: 'OPS #06', guarantee: 'Pendamping Belanja Pasar' },
          ];
          const proto = protocols[index] || protocols[0];

          return (
            <div 
              class={`p-5 sm:p-6 ${shapeClass} bg-white border border-slate-200/90 shadow-2xs hover:shadow-md transition-all duration-300 card-hover-lift flex flex-col justify-between group ${visual.hoverBorder} reveal-on-scroll ${staggerClass} relative overflow-hidden`}
            >
              <div>
                <!-- Top Row: Icon + OPS Code & Tag -->
                <div class="flex items-center justify-between mb-3.5">
                  <div class="flex items-center gap-2">
                    <div class={`w-9 h-9 rounded-xl flex items-center justify-center shadow-xs ${visual.iconBg} group-hover:scale-105 transition-transform duration-300`}>
                      <IconComponent class="w-4 h-4" />
                    </div>
                    <span class={`text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-md border ${visual.bgBadge}`}>
                      {proto.code}
                    </span>
                  </div>
                  <span class="text-[11px] font-semibold text-slate-400 group-hover:text-slate-600 transition-colors">
                    {item.tag}
                  </span>
                </div>

                <!-- Title & Description -->
                <h3 class="font-heading text-base sm:text-lg font-bold text-slate-900 tracking-[-0.015em] mb-2 group-hover:text-blue-600 transition-colors leading-snug">
                  {item.title}
                </h3>
                <p class="text-xs sm:text-[13px] text-slate-700 leading-[1.65] font-medium mb-4">
                  {item.description}
                </p>
              </div>

              <!-- Bottom Field Guarantee Spec Tag -->
              <div class="mt-2 pt-3 border-t border-slate-100 flex items-center justify-between text-xs font-semibold text-slate-600 group-hover:text-blue-700 transition-colors">
                <span class="text-[11px] font-medium text-slate-700 truncate">
                  {proto.guarantee}
                </span>
                <span class="text-[10px] font-bold text-slate-400 group-hover:text-blue-600 transition-colors shrink-0 ml-1.5">SOP</span>
              </div>
            </div>
          );
        })}
      </div>

    </div>

  </div>

  <!-- Divider 3: Architectural Apex Canopy Peak with Rising Emerald Contour -->
  <div class="relative w-full overflow-hidden leading-none pt-4 sm:pt-8 -mb-px">
    <svg 
      class="relative block w-full h-14 sm:h-18 md:h-22" 
      viewBox="0 0 1200 120" 
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <!-- Layer 1: Soft orange accent canopy underlay -->
      <path 
        d="M0,90 Q600,-30 1200,90 L1200,120 L0,120 Z" 
        fill="rgba(249, 115, 22, 0.08)"
      ></path>

      <!-- Layer 2: Main warm orange fill merging into Section 3 (#dokumentasi) -->
      <path 
        d="M0,105 Q600,-15 1200,105 L1200,120 L0,120 Z" 
        fill="#FFEDD5"
      ></path>

      <!-- Layer 3: Rising architectural apex contour line -->
      <path 
        d="M0,105 Q600,-15 1200,105" 
        fill="none" 
        stroke="#EA580C" 
        stroke-width="3" 
        stroke-linecap="round"
      ></path>

      <!-- Layer 4: Floating secondary canopy ring -->
      <path 
        d="M0,90 Q600,-30 1200,90" 
        fill="none" 
        stroke="#FB923C" 
        stroke-width="1.5" 
        stroke-dasharray="8 6" 
        stroke-opacity="0.6"
      ></path>
    </svg>
  </div>
</section>
