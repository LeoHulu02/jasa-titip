---
import { MapPin, Clock, ArrowUp } from '@lucide/astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { siteConfig, desktopNavLinks, getWhatsAppUrl } from '../data/content';

const currentYear = new Date().getFullYear();
const waUrl = getWhatsAppUrl(siteConfig.defaultWaMessage);
---


<footer class="bg-slate-950 text-slate-400 pt-12 sm:pt-16 pb-28 md:pb-16 border-t border-slate-800/80">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 mb-12">
      
      <!-- Brand & Description (5 cols) -->
      <div class="md:col-span-5">
        <div class="flex items-center gap-3 mb-4">
          <img 
            src="/logo.png" 
            alt="Logo PT Mitra Belanja Jakarta" 
            class="h-10 w-10 sm:h-11 sm:w-11 object-contain brightness-110 shrink-0"
            width="44"
            height="44"
            loading="lazy"
          />
          <div class="flex flex-col">
            <span class="text-white font-black text-sm sm:text-base tracking-tight leading-tight">
              PT MITRA BELANJA JAKARTA
            </span>
            <span class="text-[10px] sm:text-[10.5px] uppercase tracking-wider text-slate-400 font-semibold leading-tight mt-0.5">
              Sentra Grosir DKI Jakarta
            </span>
          </div>
        </div>
        <p class="text-xs sm:text-[13.5px] text-slate-300 font-medium leading-[1.65] mb-5">
          Jasa belanja terpercaya dan pendampingan personal di sentra pasar grosir Jakarta. Menghubungkan pasokan barang toko Anda dari Tanah Abang hingga Asemka ke seluruh Indonesia.
        </p>
        <a 
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-xs sm:text-sm text-emerald-400 hover:text-emerald-300 transition-colors font-semibold"
        >
          <WhatsAppIcon class="w-4 h-4" />
          <span>Hubungi Tim Admin via WhatsApp</span>
        </a>
      </div>

      <!-- Operational Info (4 cols) -->
      <div class="md:col-span-4">
        <h4 class="text-white font-bold text-xs sm:text-[13px] uppercase tracking-[0.06em] mb-4">
          Operasional & Lokasi
        </h4>
        <div class="space-y-3 text-xs sm:text-[13.5px]">
          <div class="flex items-start gap-2.5">
            <Clock class="w-4 h-4 text-slate-400 shrink-0 mt-0.5" />
            <span>{siteConfig.operatingHours}</span>
          </div>
          <div class="flex items-start gap-2.5">
            <MapPin class="w-4 h-4 text-slate-400 shrink-0 mt-0.5" />
            <div class="flex flex-col">
              <span class="text-white font-medium leading-snug">{siteConfig.address}</span>
              <span class="text-xs text-slate-400 mt-0.5">Dekat Kawasan Sentra Niaga & Pasar Grosir Jakarta</span>
            </div>
          </div>
          <div class="flex items-center gap-2.5">
            <WhatsAppIcon class="w-4 h-4 text-emerald-400 shrink-0" />
            <a href={waUrl} target="_blank" rel="noopener noreferrer" class="hover:text-white transition-colors">
              {siteConfig.phoneDisplay} (WhatsApp)
            </a>
          </div>
        </div>
      </div>

      <!-- Quick Links (3 cols) -->
      <div class="md:col-span-3">
        <h4 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">
          Navigasi Cepat
        </h4>
        <ul class="space-y-2 text-sm">
          {desktopNavLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:text-white transition-colors">
                {link.label}
              </a>
            </li>
          ))}
          <li>
            <a href="#hero" class="hover:text-white transition-colors">
              Kembali ke Atas
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="pt-8 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
      <p>
        &copy; {currentYear} {siteConfig.name}. Hak Cipta Dilindungi Undang-Undang.
      </p>
      <p class="text-slate-400">
        Seluruh Sentra Grosir &bull; DKI Jakarta
      </p>
    </div>
  </div>
</footer>
