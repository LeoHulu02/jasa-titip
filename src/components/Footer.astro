---
import { MapPin, Clock, MessageCircle, ArrowUp } from '@lucide/astro';
import { siteConfig, desktopNavLinks, getWhatsAppUrl } from '../data/content';

const currentYear = new Date().getFullYear();
const waUrl = getWhatsAppUrl(siteConfig.defaultWaMessage);
---

<footer class="bg-slate-900 text-slate-400 py-12 sm:py-16 border-t border-slate-800">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">
    <div class="grid grid-cols-1 md:grid-cols-12 gap-8 md:gap-12 mb-12">
      
      <!-- Brand & Description (5 cols) -->
      <div class="md:col-span-5">
        <div class="flex items-center gap-3 mb-4">
          <img 
            src="/logo.png" 
            alt="Logo PT Mitra Belanja Jakarta" 
            class="h-8 w-auto object-contain brightness-110"
            width="120"
            height="32"
            loading="lazy"
          />
          <span class="text-white font-bold text-base tracking-tight">
            PT MITRA BELANJA JAKARTA
          </span>
        </div>
        <p class="text-sm text-slate-400 leading-relaxed mb-6">
          Jasa belanja terpercaya dan pendampingan personal di kawasan grosir Pasar Tanah Abang, Jakarta Pusat. Kami menjembatani kebutuhan pasokan pedagang dari Sabang sampai Merauke.
        </p>
        <a 
          href={waUrl}
          target="_blank"
          rel="noopener noreferrer"
          class="inline-flex items-center gap-2 text-sm text-emerald-400 hover:text-emerald-300 transition-colors font-medium"
        >
          <MessageCircle class="w-4 h-4" />
          <span>Hubungi Tim Admin via WhatsApp</span>
        </a>
      </div>

      <!-- Operational Info (4 cols) -->
      <div class="md:col-span-4">
        <h4 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">
          Operasional & Lokasi
        </h4>
        <div class="space-y-3 text-sm">
          <div class="flex items-start gap-2.5">
            <Clock class="w-4 h-4 text-slate-400 shrink-0 mt-0.5" />
            <span>{siteConfig.operatingHours}</span>
          </div>
          <div class="flex items-start gap-2.5">
            <MapPin class="w-4 h-4 text-slate-400 shrink-0 mt-0.5" />
            <span>{siteConfig.baseLocation}</span>
          </div>
        </div>
      </div>

      <!-- Quick Links (3 cols) -->
      <div class="md:col-span-3">
        <h4 class="text-white font-semibold text-sm uppercase tracking-wider mb-4">
          Navigasi Cepat
        </h4>
        <ul class="space-y-2 text-sm">
          {desktopNavLinks.map((link) => (
            <li>
              <a href={link.href} class="hover:text-white transition-colors">
                {link.label}
              </a>
            </li>
          ))}
          <li>
            <a href="#hero" class="hover:text-white transition-colors">
              Kembali ke Atas
            </a>
          </li>
        </ul>
      </div>

    </div>

    <!-- Bottom Copyright -->
    <div class="pt-8 border-t border-slate-800/80 flex flex-col sm:flex-row items-center justify-between gap-4 text-xs text-slate-400">
      <p>
        &copy; {currentYear} {siteConfig.name}. Hak Cipta Dilindungi Undang-Undang.
      </p>
      <p class="text-slate-400">
        Pasar Tanah Abang &bull; Jakarta Pusat
      </p>
    </div>
  </div>
</footer>
