---
import { 
  Headphones, 
  ShoppingCart, 
  Users, 
  Landmark, 
  Video, 
  Package, 
  Truck, 
  ShieldCheck, 
  Info, 
  AlertTriangle,
  Tag, 
  Clock, 
  CheckCircle2 
} from '@lucide/astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { steps, shippingDisclaimer, siteConfig, getWhatsAppUrl } from '../data/content';

const waUrl = getWhatsAppUrl(siteConfig.howItWorksWaMessage);

const stepIcons = [
  Headphones,
  ShoppingCart,
  Users,
  Landmark,
  Video,
  Package,
  Truck,
  ShieldCheck
];

const pillars = [
  { icon: ShieldCheck, title: 'Aman Terpercaya', desc: 'Rekening Resmi PT' },
  { icon: Tag, title: 'Harga Terbaik', desc: 'Nota Asli Tanpa Markup' },
  { icon: Clock, title: 'Proses Cepat & Mudah', desc: 'Koordinasi via WhatsApp' },
  { icon: Headphones, title: 'Pelayanan Profesional', desc: 'Agency Siap di Lapangan' }
];
---

<section id="cara-kerja" class="pt-14 sm:pt-18 md:pt-22 pb-0 bg-gradient-to-b from-blue-100/90 via-sky-100/50 to-indigo-100/70 relative overflow-hidden">
  <!-- Modern Logistics Blueprint Micro-Dot Matrix -->
  <div 
    class="absolute inset-0 pointer-events-none opacity-[0.35]"
    style="background-image: radial-gradient(rgba(37, 99, 235, 0.22) 1.5px, transparent 1.5px); background-size: 26px 26px;"
    aria-hidden="true"
  ></div>

  <!-- Soft Ambient Atmospheric Flow Glows -->
  <div class="absolute -top-16 -left-20 w-96 h-96 rounded-full bg-blue-500/20 blur-[100px] pointer-events-none"></div>
  <div class="absolute top-1/3 -right-20 w-96 h-96 rounded-full bg-amber-400/25 blur-[110px] pointer-events-none"></div>
  <div class="absolute bottom-24 left-1/2 -translate-x-1/2 w-[600px] h-60 rounded-full bg-indigo-400/20 blur-[100px] pointer-events-none"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-12 sm:mb-16 reveal-on-scroll">
      <div class="inline-flex items-center gap-2 px-3 py-1.5 rounded-full bg-blue-50 border border-blue-200/80 text-blue-800 text-xs font-bold mb-3 shadow-2xs">
        <span class="w-2 h-2 rounded-full bg-blue-600"></span>
        <span>SOP Belanja Resmi Terpercaya</span>
      </div>
      <h2 class="font-heading text-2xl sm:text-3xl md:text-[34px] font-extrabold text-slate-900 tracking-[-0.025em] leading-[1.25] mb-3">
        Cara Kerja Jasa Belanja Grosir
      </h2>
      <p class="text-sm sm:text-base md:text-[16.5px] text-slate-600 leading-[1.65] font-normal max-w-xl sm:max-w-2xl mx-auto">
        8 alur transparan dan terstruktur dari konsultasi awal hingga pengiriman kargo tiba dengan aman di kota Anda.
      </p>
    </div>

    <!-- 8-Step Dual Column Grid: Left (1-4) & Right (5-8 + Notice) mirroring flyer layout -->
    <div class="grid grid-cols-1 lg:grid-cols-2 gap-5 sm:gap-6 mb-12 sm:mb-14">
      
      <!-- Left Column: Steps 1 to 4 -->
      <div class="space-y-4 sm:space-y-4.5">
        {steps.slice(0, 4).map((step, index) => {
          const IconComp = stepIcons[index];
          const stepNum = index + 1;
          const staggerClass = `stagger-${stepNum}`;
          
          return (
            <div 
              class={`p-5 sm:p-5.5 rounded-2xl bg-white border border-slate-200/90 shadow-2xs hover:shadow-md hover:border-blue-300 transition-all duration-300 card-hover-lift flex items-start gap-3.5 sm:gap-4 group reveal-on-scroll ${staggerClass} relative overflow-hidden`}
            >
              <!-- Left Stacked Indicators: Step Number + Circular Icon -->
              <div class="flex items-center gap-2 shrink-0 pt-0.5">
                <span class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-gradient-to-br from-amber-500 to-orange-500 text-white font-extrabold text-xs sm:text-sm flex items-center justify-center shadow-xs">
                  {stepNum}
                </span>
                <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-blue-600 text-white flex items-center justify-center shadow-xs group-hover:bg-blue-700 group-hover:scale-105 transition-all duration-300">
                  <IconComp class="w-5 h-5 text-white" />
                </div>
              </div>

              <!-- Content Body -->
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between mb-1">
                  <span class="text-[10.5px] font-bold uppercase tracking-wider text-blue-700 bg-blue-50 px-2 py-0.5 rounded border border-blue-200/60">
                    {step.badge}
                  </span>
                  <span class="text-xs font-mono text-slate-300 group-hover:text-blue-500 transition-colors font-bold">
                    #{step.number}
                  </span>
                </div>
                <h3 class="font-heading text-sm sm:text-[15px] font-bold text-slate-900 group-hover:text-blue-700 transition-colors leading-snug mb-1">
                  {step.title}
                </h3>
                <p class="text-xs sm:text-[13px] text-slate-600 leading-relaxed font-normal">
                  {step.description}
                </p>
              </div>
            </div>
          );
        })}
      </div>

      <!-- Right Column: Steps 5 to 8 + Shipping Disclaimer Callout -->
      <div class="space-y-4 sm:space-y-4.5">
        {steps.slice(4, 8).map((step, index) => {
          const stepIndex = index + 4;
          const IconComp = stepIcons[stepIndex];
          const stepNum = stepIndex + 1;
          const staggerClass = `stagger-${(stepNum % 4) + 1}`;
          
          return (
            <div 
              class={`p-5 sm:p-5.5 rounded-2xl bg-white border border-slate-200/90 shadow-2xs hover:shadow-md hover:border-blue-300 transition-all duration-300 card-hover-lift flex items-start gap-3.5 sm:gap-4 group reveal-on-scroll ${staggerClass} relative overflow-hidden`}
            >
              <!-- Left Stacked Indicators: Step Number + Circular Icon -->
              <div class="flex items-center gap-2 shrink-0 pt-0.5">
                <span class="w-7 h-7 sm:w-8 sm:h-8 rounded-full bg-gradient-to-br from-amber-500 to-orange-500 text-white font-extrabold text-xs sm:text-sm flex items-center justify-center shadow-xs">
                  {stepNum}
                </span>
                <div class="w-10 h-10 sm:w-11 sm:h-11 rounded-full bg-blue-600 text-white flex items-center justify-center shadow-xs group-hover:bg-blue-700 group-hover:scale-105 transition-all duration-300">
                  <IconComp class="w-5 h-5 text-white" />
                </div>
              </div>

              <!-- Content Body -->
              <div class="flex-1 min-w-0">
                <div class="flex items-center justify-between mb-1">
                  <span class="text-[10.5px] font-bold uppercase tracking-wider text-blue-700 bg-blue-50 px-2 py-0.5 rounded border border-blue-200/60">
                    {step.badge}
                  </span>
                  <span class="text-xs font-mono text-slate-300 group-hover:text-blue-500 transition-colors font-bold">
                    #{step.number}
                  </span>
                </div>
                <h3 class="font-heading text-sm sm:text-[15px] font-bold text-slate-900 group-hover:text-blue-700 transition-colors leading-snug mb-1">
                  {step.title}
                </h3>
                <p class="text-xs sm:text-[13px] text-slate-600 leading-relaxed font-normal">
                  {step.description}
                </p>
              </div>
            </div>
          );
        })}

        <!-- Notice / Disclaimer Callout (Ketentuan Batas Tanggung Jawab Ekspedisi) -->
        <div class="p-4 sm:p-5 rounded-2xl bg-rose-50/95 border-2 border-rose-300 shadow-sm flex items-start gap-3.5 reveal-on-scroll relative overflow-hidden">
          <div class="w-9 h-9 rounded-xl bg-rose-600 text-white flex items-center justify-center shrink-0 shadow-xs mt-0.5">
            <AlertTriangle class="w-5 h-5 text-white" />
          </div>
          <div class="text-xs sm:text-[13px] leading-relaxed w-full">
            <div class="flex items-center gap-2 mb-1 flex-wrap">
              <strong class="font-extrabold text-rose-900 text-xs sm:text-sm tracking-tight">Ketentuan Batas Tanggung Jawab Ekspedisi:</strong>
              <span class="text-[10px] font-bold uppercase tracking-wider px-2 py-0.5 rounded bg-rose-200 text-rose-800 border border-rose-300">Penting Dipahami</span>
            </div>
            <p class="font-bold text-rose-700">
              {shippingDisclaimer}
            </p>
          </div>
        </div>

      </div>

    </div>

    <!-- 4 Trust Pillars Banner Bar (Matching Flyer's Bottom Ribbon) -->
    <div class="rounded-2xl bg-gradient-to-r from-blue-700 via-blue-800 to-indigo-900 text-white p-5 sm:p-7 shadow-md mb-12 sm:mb-16 reveal-on-scroll">
      <div class="grid grid-cols-2 md:grid-cols-4 gap-4 sm:gap-6 text-center divide-y md:divide-y-0 md:divide-x divide-white/15">
        {pillars.map((item, idx) => {
          const PillarIcon = item.icon;
          return (
            <div class={`flex flex-col items-center justify-center px-3 ${idx > 0 ? 'pt-3 md:pt-0' : ''}`}>
              <div class="w-10 h-10 rounded-xl bg-white/10 backdrop-blur-md border border-white/20 flex items-center justify-center mb-2 shadow-xs">
                <PillarIcon class="w-5 h-5 text-amber-300" />
              </div>
              <h4 class="font-heading text-xs sm:text-sm font-bold tracking-tight uppercase text-white mb-0.5">
                {item.title}
              </h4>
              <p class="text-[11px] sm:text-xs text-blue-100 font-normal">
                {item.desc}
              </p>
            </div>
          );
        })}
      </div>
    </div>

    <!-- Inline Action Box at Timeline End -->
    <div class="bg-gradient-to-r from-blue-50/80 via-white to-emerald-50/70 rounded-t-[3rem] rounded-b-xl border border-blue-200/80 p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-6 shadow-xs hover:shadow-md reveal-on-scroll card-hover-lift mb-14 sm:mb-20">
      <div class="text-left">
        <div class="inline-flex items-center gap-1.5 text-xs font-bold text-emerald-800 bg-emerald-100/70 px-2.5 py-0.5 rounded-md mb-2 border border-emerald-300/60">
          <CheckCircle2 class="w-3.5 h-3.5 text-emerald-600" />
          <span>Siap Belanja Hari Ini</span>
        </div>
        <h4 class="font-heading text-lg sm:text-xl font-bold text-slate-900 mb-1">
          Punya Daftar Belanjaan yang Ingin Dicek Hari Ini?
        </h4>
        <p class="text-xs sm:text-sm text-slate-600 max-w-lg leading-relaxed">
          Kirim catatan atau foto produk Anda ke WhatsApp. Tim kami siap menuju pasar grosir hari ini juga.
        </p>
      </div>

      <a 
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2.5 bg-[#25D366] hover:bg-[#1EBE5D] text-white px-6 py-3.5 rounded-xl text-sm font-bold shadow-sm hover:shadow-md transition-all shrink-0 active:scale-95 group text-center w-full sm:w-auto"
      >
        <WhatsAppIcon class="w-4 h-4 text-white group-hover:rotate-6 transition-transform" />
        <span>Mulai Belanja via WhatsApp</span>
      </a>
    </div>

  </div>

  <!-- Divider 4: Deep Sculpted Crescent Valley with Offset Cyan Arc -->
  <div class="relative w-full overflow-hidden leading-none pt-4 sm:pt-8 -mb-px">
    <svg 
      class="relative block w-full h-14 sm:h-18 md:h-22" 
      viewBox="0 0 1200 120" 
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <!-- Layer 1: Translucent deep valley scoop underlay -->
      <path 
        d="M0,15 C300,105 900,105 1200,15 L1200,120 L0,120 Z" 
        fill="rgba(37, 99, 235, 0.08)"
      ></path>

      <!-- Layer 2: Main lavender fill merging into Section 5 (#kategori) -->
      <path 
        d="M0,35 C320,118 880,118 1200,35 L1200,120 L0,120 Z" 
        fill="#EDE9FE"
      ></path>

      <!-- Layer 3: Sweeping royal blue valley contour line -->
      <path 
        d="M0,35 C320,118 880,118 1200,35" 
        fill="none" 
        stroke="#2563EB" 
        stroke-width="3" 
        stroke-linecap="round"
      ></path>

      <!-- Layer 4: Cyan offset secondary floating curve -->
      <path 
        d="M0,20 C320,102 880,102 1200,20" 
        fill="none" 
        stroke="#38BDF8" 
        stroke-width="1.5" 
        stroke-dasharray="8 6" 
        stroke-opacity="0.6"
      ></path>
    </svg>
  </div>
</section>
