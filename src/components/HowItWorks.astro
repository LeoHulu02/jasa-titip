---
import { MessageSquare, Video, Receipt, Truck, ArrowRight, CheckCircle2 } from '@lucide/astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { steps, siteConfig, getWhatsAppUrl } from '../data/content';

const waUrl = getWhatsAppUrl(siteConfig.howItWorksWaMessage);

const stepIcons = [
  MessageSquare,
  Video,
  Receipt,
  Truck
];

const stepColors = [
  { bg: 'bg-blue-600', ring: 'ring-blue-100', text: 'text-blue-700', badge: 'bg-blue-50 border-blue-200' },
  { bg: 'bg-blue-600', ring: 'ring-blue-100', text: 'text-blue-700', badge: 'bg-blue-50 border-blue-200' },
  { bg: 'bg-blue-600', ring: 'ring-blue-100', text: 'text-blue-700', badge: 'bg-blue-50 border-blue-200' },
  { bg: 'bg-blue-600', ring: 'ring-blue-100', text: 'text-blue-700', badge: 'bg-blue-50 border-blue-200' }
];
---

<section id="cara-kerja" class="py-14 sm:py-18 md:py-22 bg-slate-50/70 border-b border-slate-200/80 relative">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-12 md:mb-14 reveal-on-scroll">
      <p class="text-xs font-bold uppercase tracking-wider text-blue-700 mb-2.5">
        Alur Praktis 4 Langkah
      </p>
      <h2 class="text-2xl sm:text-3xl md:text-[32px] lg:text-[34px] font-extrabold text-slate-900 tracking-[-0.025em] leading-[1.25] mb-3">
        Cara Kerjanya Simpel, Transparan, & Terpantau
      </h2>
      <p class="text-sm sm:text-base md:text-[16.5px] text-slate-600 leading-[1.65] font-normal max-w-xl sm:max-w-2xl mx-auto">
        Dari kirim list belanja awal hingga resi kargo diterima, semua proses dipantau langsung lewat WhatsApp Anda.
      </p>
    </div>

    <!-- Lively Vertical Timeline (4 Steps) -->
    <div class="relative">
      <!-- Clean connecting line for desktop & tablet -->
      <div class="hidden sm:block absolute left-9 top-8 bottom-8 w-0.5 bg-slate-200 -z-0"></div>

      <div class="space-y-5 sm:space-y-7 relative z-10">
        {steps.map((step, index) => {
          const StepIcon = stepIcons[index] || MessageSquare;
          const styling = stepColors[index] || stepColors[0];

          return (
            <div class={`flex flex-col sm:flex-row items-start gap-4 sm:gap-6 bg-white sm:bg-transparent p-5 sm:p-0 rounded-2xl sm:rounded-none border sm:border-0 border-slate-200/80 shadow-2xs sm:shadow-none reveal-on-scroll stagger-${index + 1}`}>
              
              <!-- Number & Icon Node -->
              <div class={`w-13 h-13 sm:w-16 sm:h-16 rounded-2xl ${styling.bg} text-white flex flex-col items-center justify-center shrink-0 shadow-sm ring-4 ${styling.ring} transition-transform duration-300 hover:scale-105`}>
                <StepIcon class="w-5 h-5 sm:w-6 sm:h-6 mb-0.5 text-white" />
                <span class="text-[10px] sm:text-xs font-bold uppercase tracking-wider">0{index + 1}</span>
              </div>

              <!-- Content Card -->
              <div class="flex-1 bg-white p-5 sm:p-6 rounded-2xl border border-slate-200/90 shadow-2xs hover:shadow-md card-hover-lift transition-all duration-300 group">
                <div class="flex items-center justify-between gap-2 mb-2">
                  <span class={`text-[10.5px] sm:text-[11px] font-bold uppercase tracking-wider px-2 py-0.5 rounded-md border ${styling.badge} ${styling.text}`}>
                    {step.badge}
                  </span>
                  <span class="text-xs text-slate-400 font-medium">Langkah {index + 1} dari 4</span>
                </div>
                <h3 class="text-base sm:text-lg font-bold text-slate-900 tracking-[-0.015em] mb-1.5 group-hover:text-blue-600 transition-colors leading-snug">
                  {step.title}
                </h3>
                <p class="text-xs sm:text-[13.5px] text-slate-600 leading-[1.6] font-normal">
                  {step.description}
                </p>
              </div>

            </div>
          );
        })}
      </div>
    </div>

    <!-- Inline Action Box at Timeline End -->
    <div class="mt-12 sm:mt-16 bg-white rounded-2xl border border-slate-200/90 p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-6 shadow-xs hover:shadow-md reveal-on-scroll card-hover-lift">
      <div class="text-left">
        <div class="inline-flex items-center gap-1.5 text-xs font-bold text-emerald-700 bg-emerald-50 px-2.5 py-0.5 rounded-full mb-2 border border-emerald-200">
          <CheckCircle2 class="w-3.5 h-3.5 text-emerald-600" />
          <span>Siap Belanja Hari Ini</span>
        </div>
        <h4 class="text-lg sm:text-xl font-bold text-slate-900 mb-1">
          Punya daftar barang yang ingin dibeli sekarang?
        </h4>
        <p class="text-sm text-slate-600 max-w-lg leading-relaxed">
          Kirimkan foto sampel atau list barang beserta sentra pasar tujuan, admin kami langsung hitungkan estimasi modal dan ketersediaan stoknya.
        </p>
      </div>

      <a 
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2.5 bg-[#25D366] hover:bg-[#1EBE5D] text-white px-6 py-3.5 rounded-xl text-sm font-bold shadow-sm hover:shadow-md transition-all shrink-0 active:scale-95 group"
      >
        <WhatsAppIcon class="w-4 h-4 text-white group-hover:rotate-6 transition-transform" />
        <span>Konsultasi Sekarang</span>
      </a>
    </div>

  </div>
</section>
