---
import { desktopNavLinks, siteConfig, getWhatsAppUrl } from '../data/content';
import WhatsAppIcon from './WhatsAppIcon.astro';

const waNavUrl = getWhatsAppUrl('Halo Admin PT Mitra Belanja Jakarta, saya ingin konsultasi layanan belanja & pengiriman kargo.');
---

<header 
  class="sticky top-0 z-40 w-full bg-white/95 backdrop-blur-md border-b border-slate-200/80 transition-all duration-200 select-none" 
  id="top-navbar"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 md:h-18 flex items-center justify-between gap-4 md:gap-8">
    
    <!-- Brand / Corporate Identity (Shares the exact same unified background) -->
    <a 
      href="#hero" 
      class="flex items-center gap-2.5 sm:gap-3 group shrink-0" 
      aria-label="PT Mitra Belanja Jakarta - Beranda"
    >
      <div class="relative shrink-0 flex items-center justify-center">
        <img 
          src="/logo.png" 
          alt="Logo PT Mitra Belanja Jakarta" 
          class="h-9 w-9 sm:h-10 sm:w-10 md:h-11 md:w-11 object-contain transition-transform duration-200 group-hover:scale-105"
          width="44"
          height="44"
          loading="eager"
        />
      </div>
      <div class="flex flex-col">
        <div class="flex items-center gap-1.5 sm:gap-2">
          <span class="text-sm sm:text-base md:text-lg font-black tracking-tight text-slate-900 group-hover:text-blue-600 transition-colors leading-none">
            MITRA BELANJA
          </span>
          <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[9px] sm:text-[10px] font-bold uppercase tracking-wider bg-blue-50 text-blue-700 border border-blue-200/70">
            PT Resmi
          </span>
        </div>
        <span class="text-[10px] sm:text-[10.5px] md:text-[11.5px] font-semibold text-slate-500 tracking-wider uppercase leading-snug mt-1">
          Pusat Grosir Jakarta
        </span>
      </div>
    </a>

    <!-- Desktop & Tablet Navigation: Unified with Header (Boxed with Left Accent & Fading Blur) -->
    <nav 
      id="desktop-nav"
      class="hidden md:flex items-center gap-1.5 lg:gap-2" 
      aria-label="Navigasi Utama"
    >
      {desktopNavLinks.map((link) => (
        <a 
          href={link.href} 
          class="desktop-nav-link relative px-3.5 md:px-4 py-2 rounded-r-lg rounded-l-xs text-xs md:text-[13px] lg:text-sm font-semibold border-l-[3.5px] border-l-transparent text-slate-600 hover:text-slate-950 hover:bg-slate-100/70 transition-all duration-200 whitespace-nowrap"
        >
          {link.label}
        </a>
      ))}
    </nav>

    <!-- Desktop Quick Contact CTA (Balances the navbar) -->
    <div class="hidden lg:flex items-center">
      <a 
        href={waNavUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center gap-2 bg-[#25D366] hover:bg-[#1EBE5D] text-white px-4 py-2 rounded-full text-xs font-bold shadow-xs hover:shadow-md transition-all active:scale-95 group"
      >
        <WhatsAppIcon class="w-3.5 h-3.5 text-white group-hover:rotate-6 transition-transform" />
        <span>Konsultasi WA</span>
      </a>
    </div>

  </div>
</header>

<style>
  /* Kotak aktif dengan garis kiri biru dan background gradien memudar + blur ke ujung */
  :global(.nav-link-active) {
    border-left-color: #2563eb !important;
    background-image: linear-gradient(to right, rgba(37, 99, 235, 0.18), rgba(37, 99, 235, 0.05), transparent) !important;
    backdrop-filter: blur(8px) !important;
    -webkit-backdrop-filter: blur(8px) !important;
    color: #1d4ed8 !important;
    font-weight: 700 !important;
  }
</style>

<script>
  // Add subtle shadow and elevated border on scroll
  const nav = document.getElementById('top-navbar');
  if (nav) {
    const handleScroll = () => {
      if (window.scrollY > 15) {
        nav.classList.add('shadow-xs', 'border-slate-300/90', 'bg-white/98');
        nav.classList.remove('bg-white/95');
      } else {
        nav.classList.remove('shadow-xs', 'border-slate-300/90', 'bg-white/98');
        nav.classList.add('bg-white/95');
      }
    };
    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();
  }

  // Active link scroll spy with bespoke boxed & fading blur styling
  function setupDesktopSpy() {
    const navLinks = document.querySelectorAll<HTMLAnchorElement>('.desktop-nav-link');
    if (!navLinks.length) return;
    const sections = ['layanan', 'dokumentasi', 'cara-kerja', 'kategori', 'faq'];

    function updateActive() {
      const scrollPos = window.scrollY + 140;
      let currentSection = '';

      for (const id of sections) {
        const el = document.getElementById(id);
        if (el) {
          const top = el.offsetTop;
          const height = el.offsetHeight;
          if (scrollPos >= top && scrollPos < top + height) {
            currentSection = id;
            break;
          }
        }
      }

      navLinks.forEach((link) => {
        const href = link.getAttribute('href');
        if (href === `#${currentSection}`) {
          link.classList.add('nav-link-active');
        } else {
          link.classList.remove('nav-link-active');
        }
      });
    }

    window.addEventListener('scroll', updateActive, { passive: true });
    updateActive();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupDesktopSpy);
  } else {
    setupDesktopSpy();
  }
</script>
