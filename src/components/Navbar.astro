---
import { desktopNavLinks, siteConfig } from '../data/content';
---

<header 
  class="sticky top-0 z-40 w-full bg-white/95 backdrop-blur-md border-b border-slate-200/80 transition-all duration-200 select-none" 
  id="top-navbar"
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 h-16 md:h-18 flex items-center justify-between gap-4 md:gap-8">
    
    <!-- Brand / Corporate Identity -->
    <a 
      href="#hero" 
      class="flex items-center gap-2.5 sm:gap-3 group shrink-0" 
      aria-label="PT Mitra Belanja Jakarta - Beranda"
    >
      <div class="relative shrink-0 flex items-center justify-center">
        <img 
          src="/logo.png" 
          alt="Logo PT Mitra Belanja Jakarta" 
          class="h-9 w-9 sm:h-10 sm:w-10 md:h-11 md:w-11 object-contain transition-transform duration-200 group-hover:scale-105"
          width="44"
          height="44"
          loading="eager"
        />
      </div>
      <div class="flex flex-col">
        <div class="flex items-center gap-1.5 sm:gap-2">
          <span class="text-sm sm:text-base md:text-lg font-black tracking-tight text-slate-900 group-hover:text-blue-600 transition-colors leading-none">
            MITRA BELANJA
          </span>
          <span class="inline-flex items-center px-1.5 py-0.5 rounded text-[9px] sm:text-[10px] font-bold uppercase tracking-wider bg-blue-50 text-blue-700 border border-blue-200/70">
            PT Resmi
          </span>
        </div>
        <span class="text-[10px] sm:text-[10.5px] md:text-[11.5px] font-semibold text-slate-500 tracking-wider uppercase leading-snug mt-1">
          Pusat Grosir Jakarta
        </span>
      </div>
    </a>

    <!-- Desktop & Tablet Navigation: Modern, Spacious, Clean -->
    <nav 
      id="desktop-nav"
      class="hidden md:flex items-center gap-1 lg:gap-1.5 p-1 rounded-2xl bg-slate-50/90 border border-slate-200/80" 
      aria-label="Navigasi Utama"
    >
      {desktopNavLinks.map((link) => (
        <a 
          href={link.href} 
          class="desktop-nav-link px-3 md:px-3.5 lg:px-4 py-2 rounded-xl text-xs md:text-[13.5px] lg:text-sm font-semibold text-slate-600 hover:text-slate-950 hover:bg-white/80 border border-transparent transition-all duration-200 whitespace-nowrap"
        >
          {link.label}
        </a>
      ))}
    </nav>
  </div>
</header>

<script>
  // Add subtle shadow and elevated border on scroll
  const nav = document.getElementById('top-navbar');
  if (nav) {
    const handleScroll = () => {
      if (window.scrollY > 15) {
        nav.classList.add('shadow-xs', 'border-slate-300/90', 'bg-white/98');
        nav.classList.remove('bg-white/95');
      } else {
        nav.classList.remove('shadow-xs', 'border-slate-300/90', 'bg-white/98');
        nav.classList.add('bg-white/95');
      }
    };
    window.addEventListener('scroll', handleScroll, { passive: true });
    handleScroll();
  }

  // Active link scroll spy with bespoke, modern styling (Anti-AI-Slop)
  function setupDesktopSpy() {
    const navLinks = document.querySelectorAll<HTMLAnchorElement>('.desktop-nav-link');
    if (!navLinks.length) return;
    const sections = ['layanan', 'dokumentasi', 'cara-kerja', 'kategori', 'faq'];

    function updateActive() {
      const scrollPos = window.scrollY + 140;
      let currentSection = '';

      for (const id of sections) {
        const el = document.getElementById(id);
        if (el) {
          const top = el.offsetTop;
          const height = el.offsetHeight;
          if (scrollPos >= top && scrollPos < top + height) {
            currentSection = id;
            break;
          }
        }
      }

      navLinks.forEach((link) => {
        const href = link.getAttribute('href');
        if (href === `#${currentSection}`) {
          // Bespoke active state: clean blue tint + crisp border + font-bold
          link.classList.add('bg-white', 'text-blue-600', 'border-blue-200/80', 'shadow-2xs');
          link.classList.remove('text-slate-600', 'border-transparent');
        } else {
          link.classList.remove('bg-white', 'text-blue-600', 'border-blue-200/80', 'shadow-2xs');
          link.classList.add('text-slate-600', 'border-transparent');
        }
      });
    }

    window.addEventListener('scroll', updateActive, { passive: true });
    updateActive();
  }

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', setupDesktopSpy);
  } else {
    setupDesktopSpy();
  }
</script>
