---
import { Tag, Sparkles } from '@lucide/astro';
import { categories } from '../data/content';
---

<section id="kategori" class="py-16 sm:py-20 md:py-24 bg-white border-b border-slate-100">
  <div class="max-w-4xl mx-auto px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-14">
      <span class="text-xs uppercase font-bold tracking-wider text-blue-600 bg-blue-50 px-2.5 py-1 rounded inline-block mb-3">
        Kategori Produk
      </span>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight mb-4">
        Kategori yang Sering Kami Tangani
      </h2>
      <p class="text-slate-600 text-base leading-relaxed">
        Dari tekstil Tanah Abang, fashion Mangga Dua, mainan Asemka, souvenir Jatinegara, hingga teknik Glodok.
      </p>
    </div>

    <!-- Category Tag Cloud -->
    <div class="flex flex-wrap justify-center gap-2.5 sm:gap-3.5 mb-10">
      {categories.map((category) => (
        <div class="inline-flex items-center gap-2 px-3.5 sm:px-4 py-2 sm:py-2.5 rounded-full bg-slate-50 hover:bg-blue-50 border border-slate-200 hover:border-blue-200 text-slate-700 hover:text-blue-700 text-xs sm:text-sm font-medium transition-colors cursor-default">
          <Tag class="w-3.5 h-3.5 text-blue-500" />
          <span>{category}</span>
        </div>
      ))}
    </div>

    <!-- Bottom note -->
    <div class="text-center p-4 rounded-lg bg-slate-50 border border-slate-200/80 max-w-xl mx-auto">
      <p class="text-xs sm:text-sm text-slate-600">
        <strong class="text-slate-800">Mencari komoditas di luar daftar ini?</strong> Kami dapat mencarikan hampir semua jenis produk grosir yang diperdagangkan di seluruh sentra pasar kota Jakarta.
      </p>
    </div>

  </div>
</section>
