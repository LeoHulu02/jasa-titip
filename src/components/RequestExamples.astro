---
import { Shirt, Footprints, Gift, Package, Wrench, Layers, ArrowRight, MapPin } from '@lucide/astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { productCategories, siteConfig, getWhatsAppUrl } from '../data/content';

const waUrl = getWhatsAppUrl('Halo Admin Mitra Belanja, saya ingin menanyakan ketersediaan produk grosir tertentu di Jakarta.');

const categoryIcons = [
  Shirt,
  Footprints,
  Gift,
  Package,
  Wrench,
  Layers,
];
---

<section id="kategori" class="py-14 sm:py-18 md:py-22 bg-white border-b border-slate-100 relative">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-12 md:mb-14 reveal-on-scroll">
      <p class="text-xs font-bold uppercase tracking-wider text-blue-700 mb-2.5">
        Katalog Komoditas Niaga
      </p>
      <h2 class="text-2xl sm:text-3xl md:text-[32px] lg:text-[34px] font-extrabold text-slate-900 tracking-[-0.025em] leading-[1.25] mb-3">
        Produk yang Bisa Kami Cari
      </h2>
      <p class="text-sm sm:text-base md:text-[16.5px] text-slate-600 leading-[1.65] font-normal max-w-xl sm:max-w-2xl mx-auto">
        Akses langsung ke distributor resmi, gudang, dan supplier tangan pertama di seluruh sentra niaga Jakarta.
      </p>
    </div>

    <!-- 6 Professional Category Cards Grid -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-4 sm:gap-5 mb-10 sm:mb-12">
      {productCategories.map((cat, idx) => {
        const IconComponent = categoryIcons[idx] || Package;
        const staggerClass = `stagger-${(idx % 4) + 1}`;

        return (
          <div class={`p-5 sm:p-6 rounded-2xl bg-slate-50/80 hover:bg-white border border-slate-200/90 hover:border-blue-300 shadow-2xs hover:shadow-md transition-all duration-300 card-hover-lift flex flex-col justify-between group reveal-on-scroll ${staggerClass}`}>
            <div>
              <div class="flex items-center justify-between gap-3 mb-4">
                <div class="w-10 h-10 rounded-xl bg-blue-600 text-white flex items-center justify-center shrink-0 shadow-xs group-hover:scale-105 transition-transform duration-300">
                  <IconComponent class="w-5 h-5" />
                </div>
                <div class="inline-flex items-center gap-1 text-[11px] font-semibold text-slate-500 bg-white px-2.5 py-1 rounded-lg border border-slate-200/80">
                  <MapPin class="w-3 h-3 text-blue-600 shrink-0" />
                  <span>{cat.sentra}</span>
                </div>
              </div>

              <h3 class="text-base sm:text-lg font-bold text-slate-900 tracking-[-0.015em] mb-2 group-hover:text-blue-600 transition-colors leading-snug">
                {cat.name}
              </h3>
              <p class="text-xs sm:text-[13px] text-slate-600 leading-[1.6] font-normal">
                {cat.items}
              </p>
            </div>

            <div class="mt-4 pt-3 border-t border-slate-200/70 flex items-center justify-between text-xs font-semibold text-blue-600 opacity-80 group-hover:opacity-100 transition-opacity">
              <span>Siap dicarikan tim lapangan</span>
              <ArrowRight class="w-3.5 h-3.5 group-hover:translate-x-1 transition-transform" />
            </div>
          </div>
        );
      })}
    </div>

    <!-- Interactive Assistance Card with Direct Search CTA -->
    <div class="bg-slate-900 text-white rounded-2xl p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-6 shadow-md reveal-on-scroll stagger-2 card-hover-lift">
      <div class="text-left">
        <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-400 mb-1.5">
          <Package class="w-4 h-4 text-emerald-400" />
          <span>Sourcing Fleksibel & Terverifikasi</span>
        </span>
        <h3 class="text-lg sm:text-xl font-bold text-white mb-1">
          Mencari komoditas atau merk di luar daftar di atas?
        </h3>
        <p class="text-xs sm:text-sm text-slate-300 max-w-xl leading-relaxed">
          Kirimkan foto sampel atau spesifikasi barang yang ingin Anda cari di Jakarta. Tim kami akan langsung menyusuri sentra toko terkait untuk mengecek stok dan harga modal aslinya.
        </p>
      </div>

      <a 
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2.5 bg-[#25D366] hover:bg-[#1EBE5D] text-white px-6 py-3.5 rounded-xl text-sm font-bold shadow-sm hover:shadow-md transition-all shrink-0 active:scale-95 group text-center w-full sm:w-auto"
      >
        <WhatsAppIcon class="w-4 h-4 text-white group-hover:rotate-6 transition-transform" />
        <span>Tanya Barang yang Anda Cari</span>
        <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
      </a>
    </div>

  </div>
</section>
