---
import { Shirt, Footprints, Gift, Package, Wrench, Layers, ArrowRight, MapPin } from '@lucide/astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { productCategories, siteConfig, getWhatsAppUrl } from '../data/content';

const waUrl = getWhatsAppUrl('Halo Admin Mitra Belanja, saya ingin menanyakan ketersediaan produk grosir tertentu di Jakarta.');

const categoryIcons = [
  Shirt,
  Footprints,
  Gift,
  Package,
  Wrench,
  Layers,
];
const categoryMeta = [
  {
    themeBg: 'bg-gradient-to-br from-blue-50/70 via-white to-indigo-50/40 border-blue-200/90 hover:border-blue-400',
    iconBg: 'bg-blue-600 text-white',
    badgeStyle: 'bg-blue-100/80 text-blue-800 border-blue-200',
    chipStyle: 'bg-white hover:bg-blue-50 text-slate-800 hover:text-blue-700 border-slate-200/80 shadow-2xs',
    accentText: 'text-blue-700',
    marketHighlight: 'Sentra Busana Terbesar Se-Asia Tenggara'
  },
  {
    themeBg: 'bg-gradient-to-br from-emerald-50/50 via-white to-teal-50/30 border-emerald-200/80 hover:border-emerald-400',
    iconBg: 'bg-emerald-600 text-white',
    badgeStyle: 'bg-emerald-100/80 text-emerald-800 border-emerald-200',
    chipStyle: 'bg-white hover:bg-emerald-50 text-slate-800 hover:text-emerald-700 border-slate-200/80 shadow-2xs',
    accentText: 'text-emerald-700',
    marketHighlight: 'Produsen Langsung & Sentra Sepatu'
  },
  {
    themeBg: 'bg-gradient-to-br from-amber-50/50 via-white to-orange-50/30 border-amber-200/80 hover:border-amber-400',
    iconBg: 'bg-amber-500 text-white',
    badgeStyle: 'bg-amber-100/80 text-amber-900 border-amber-200',
    chipStyle: 'bg-white hover:bg-amber-50 text-slate-800 hover:text-amber-800 border-slate-200/80 shadow-2xs',
    accentText: 'text-amber-800',
    marketHighlight: 'Distributor Mainan & Aksesoris Impor/Lokal'
  },
  {
    themeBg: 'bg-gradient-to-br from-cyan-50/50 via-white to-sky-50/30 border-cyan-200/80 hover:border-cyan-400',
    iconBg: 'bg-cyan-600 text-white',
    badgeStyle: 'bg-cyan-100/80 text-cyan-900 border-cyan-200',
    chipStyle: 'bg-white hover:bg-cyan-50 text-slate-800 hover:text-cyan-800 border-slate-200/80 shadow-2xs',
    accentText: 'text-cyan-800',
    marketHighlight: 'Kebutuhan Kemasan Olshop, UMKM & F&B'
  },
  {
    themeBg: 'bg-gradient-to-br from-indigo-50/50 via-white to-purple-50/30 border-indigo-200/80 hover:border-indigo-400',
    iconBg: 'bg-indigo-600 text-white',
    badgeStyle: 'bg-indigo-100/80 text-indigo-900 border-indigo-200',
    chipStyle: 'bg-white hover:bg-indigo-50 text-slate-800 hover:text-indigo-800 border-slate-200/80 shadow-2xs',
    accentText: 'text-indigo-800',
    marketHighlight: 'Pusat Alat Teknik & Perkakas Grosir'
  },
  {
    themeBg: 'bg-gradient-to-r from-slate-50 via-white to-blue-50/40 border-slate-300/80 hover:border-blue-400',
    iconBg: 'bg-slate-900 text-white',
    badgeStyle: 'bg-slate-100 text-slate-800 border-slate-300',
    chipStyle: 'bg-white hover:bg-slate-100 text-slate-800 hover:text-slate-900 border-slate-200/80 shadow-2xs',
    accentText: 'text-slate-800',
    marketHighlight: 'Sourcing Bebas Segala Komoditas Sesuai Permintaan'
  }
];
---

<section id="kategori" class="pt-14 sm:pt-18 md:pt-22 pb-0 bg-gradient-to-b from-slate-50/70 via-indigo-50/20 to-blue-50/35 relative overflow-hidden">
  <!-- Subtle Multi-Chromatic Commerce Dot Matrix Pattern -->
  <div 
    class="absolute inset-0 pointer-events-none opacity-[0.3]"
    style="background-image: radial-gradient(rgba(99, 102, 241, 0.12) 1.2px, transparent 1.2px), radial-gradient(rgba(245, 158, 11, 0.1) 1.2px, transparent 1.2px); background-size: 32px 32px; background-position: 0 0, 16px 16px;"
    aria-hidden="true"
  ></div>

  <!-- Soft Chromatic Ambient Halos (Echoing the Category Color Accents) -->
  <div class="absolute -top-16 -right-16 w-96 h-96 rounded-full bg-indigo-300/15 blur-[100px] pointer-events-none"></div>
  <div class="absolute top-1/2 -left-20 w-80 h-80 rounded-full bg-emerald-300/15 blur-[100px] pointer-events-none"></div>
  <div class="absolute bottom-20 right-10 w-80 h-80 rounded-full bg-amber-300/15 blur-[100px] pointer-events-none"></div>

  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
    
    <!-- Section Header -->
    <div class="text-center max-w-2xl mx-auto mb-10 sm:mb-14 reveal-on-scroll">
      <p class="text-xs font-bold uppercase tracking-wider text-blue-700 mb-2.5">
        Komoditas Pasar Grosir
      </p>
      <h2 class="font-heading text-2xl sm:text-3xl md:text-[34px] font-extrabold text-slate-900 tracking-[-0.025em] leading-[1.25] mb-3">
        Barang Apa Saja yang Bisa Kami Belanjakan?
      </h2>
      <p class="text-sm sm:text-base md:text-[16.5px] text-slate-600 leading-[1.65] font-normal max-w-xl sm:max-w-2xl mx-auto">
        Akses langsung ke distributor toko fisik di seluruh sentra grosir Jakarta dari tempat usaha Anda.
      </p>
    </div>

    <!-- Asymmetric Creative Category Layout with Distinct Sculpted Silhouettes -->
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-12 gap-4 sm:gap-5 mb-10 sm:mb-14">
      {productCategories.map((cat, idx) => {
        const IconComponent = categoryIcons[idx] || Package;
        const meta = categoryMeta[idx] || categoryMeta[0];
        const staggerClass = `stagger-${(idx % 4) + 1}`;
        const itemChips = cat.items.split(',').map((s) => s.trim()).filter(Boolean);
        
        // Distinct Sculpted Silhouette per Category Card
        const categoryShapes = [
          'rounded-tl-[3.5rem] rounded-br-[2.5rem] rounded-tr-xl rounded-bl-xl', // Cat 0: Fashion (Expansive Portal Arch)
          'rounded-t-[3rem] rounded-b-xl',                                        // Cat 1: Sepatu (Tall Cathedral Arch)
          'rounded-b-[3rem] rounded-t-xl',                                        // Cat 2: Mainan (Inverted Curved Scoop)
          'rounded-tr-[3rem] rounded-bl-[3rem] rounded-tl-xl rounded-br-xl',       // Cat 3: Kemasan (Tactile Organic Silhouette)
          'rounded-tl-[3rem] rounded-br-[3rem] rounded-tr-xl rounded-bl-xl',       // Cat 4: Teknik (Asymmetric Corner Wing)
          'rounded-t-[2.75rem] rounded-b-[1.5rem]',                               // Cat 5: Lainnya (Wide Panoramic Vault)
        ];
        const shapeClass = categoryShapes[idx] || 'rounded-2xl';

        // Asymmetric visual weight
        const colSpanClass = idx === 0 
          ? 'lg:col-span-8' 
          : idx === 1 
          ? 'lg:col-span-4' 
          : idx === 2 
          ? 'lg:col-span-4' 
          : idx === 3 
          ? 'lg:col-span-4' 
          : idx === 4 
          ? 'lg:col-span-4' 
          : 'lg:col-span-12';

        return (
          <div 
            class={`${colSpanClass} ${meta.themeBg} ${shapeClass} p-5 sm:p-6 border shadow-2xs hover:shadow-md transition-all duration-300 card-hover-lift flex flex-col justify-between group reveal-on-scroll ${staggerClass} relative overflow-hidden`}
          >
            <div>
              <!-- Top Row: Sentra Location Tag + Category Icon -->
              <div class="flex items-center justify-between gap-3 mb-3.5">
                <div class="inline-flex items-center gap-1.5 text-[11px] font-semibold text-slate-700 bg-white/90 backdrop-blur-xs px-2.5 py-1 rounded-lg border border-slate-200/90 shadow-2xs">
                  <MapPin class="w-3.5 h-3.5 text-blue-600 shrink-0" />
                  <span>{cat.sentra}</span>
                </div>
                <div class={`w-9 h-9 rounded-xl ${meta.iconBg} flex items-center justify-center shrink-0 shadow-xs group-hover:scale-105 transition-transform duration-300`}>
                  <IconComponent class="w-4 h-4" />
                </div>
              </div>

              <!-- Title & Volume Badge -->
              <div class="flex items-center justify-between gap-2 mb-2">
                <h3 class="font-heading text-base sm:text-lg font-bold text-slate-900 tracking-[-0.015em] group-hover:text-blue-600 transition-colors leading-snug">
                  {cat.name}
                </h3>
                {idx === 0 && (
                  <span class="text-[10px] font-bold text-blue-700 bg-blue-100/80 px-2 py-0.5 rounded-md shrink-0">
                    Volume Terbesar
                  </span>
                )}
              </div>
              
              <!-- Tangible Commodity Chips/Pills (Distinct Merchandise Feel) -->
              <div class="flex flex-wrap gap-1.5 my-3">
                {itemChips.map((chip) => (
                  <span class={`text-[11px] sm:text-[11.5px] font-medium px-2.5 py-1 rounded-lg border transition-colors ${meta.chipStyle}`}>
                    {chip}
                  </span>
                ))}
              </div>
            </div>

            <!-- Card Footer: Unique Sentra Context -->
            <div class={`pt-3 mt-1 border-t border-slate-200/60 flex items-center justify-between text-xs font-semibold ${meta.accentText}`}>
              <span class="flex items-center gap-1.5 truncate">
                <span class="w-1.5 h-1.5 rounded-full bg-current shrink-0"></span>
                <span class="truncate">{meta.marketHighlight}</span>
              </span>
              <span class="text-[10px] font-bold text-slate-400 group-hover:text-slate-600 transition-colors uppercase tracking-wider shrink-0 ml-2">Sentra</span>
            </div>
          </div>
        );
      })}
    </div>

    <!-- Sourcing Action Card (Sculpted Diagonal Silhouette) -->
    <div class="bg-slate-900 text-white rounded-tl-[2.75rem] rounded-br-[2.75rem] rounded-tr-xl rounded-bl-xl p-6 sm:p-8 flex flex-col sm:flex-row items-center justify-between gap-6 shadow-md reveal-on-scroll stagger-2 card-hover-lift mb-12 sm:mb-16">
      <div class="text-left">
        <span class="inline-flex items-center gap-1.5 text-xs font-semibold text-emerald-400 mb-1.5">
          <Package class="w-4 h-4 text-emerald-400" />
          <span>Sourcing Bebas Segala Produk</span>
        </span>
        <h3 class="font-heading text-lg sm:text-xl font-bold text-white mb-1">
          Mencari merk atau barang spesifik di luar daftar ini?
        </h3>
        <p class="text-xs sm:text-sm text-slate-300 max-w-xl leading-relaxed">
          Kirimkan foto sampel atau spesifikasinya ke admin kami. Tim kami akan langsung menyusuri toko terkait di Jakarta.
        </p>
      </div>

      <a 
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2.5 bg-[#25D366] hover:bg-[#1EBE5D] text-white px-6 py-3.5 rounded-xl text-sm font-bold shadow-sm hover:shadow-md transition-all shrink-0 active:scale-95 group text-center w-full sm:w-auto"
      >
        <WhatsAppIcon class="w-4 h-4 text-white group-hover:rotate-6 transition-transform" />
        <span>Tanya Barang yang Anda Cari</span>
        <ArrowRight class="w-4 h-4 group-hover:translate-x-1 transition-transform" />
      </a>
    </div>

  </div>

  <!-- Divider 2: Liquid Cascading Triple Sine Wave with Fluid Contour Lines -->
  <div class="relative w-full overflow-hidden leading-none pt-4 sm:pt-8 -mb-px">
    <svg 
      class="relative block w-full h-14 sm:h-18 md:h-22" 
      viewBox="0 0 1200 120" 
      preserveAspectRatio="none"
      aria-hidden="true"
    >
      <!-- Layer 1: Translucent liquid ocean wave -->
      <path 
        d="M0,50 C180,10 320,105 560,45 C800,-10 980,95 1200,35 L1200,120 L0,120 Z" 
        fill="rgba(2, 132, 199, 0.08)"
      ></path>

      <!-- Layer 2: Main slate-50 fill merging into Section 3 (#layanan) -->
      <path 
        d="M0,68 C180,28 320,118 560,62 C800,8 980,110 1200,52 L1200,120 L0,120 Z" 
        fill="#F8FAFC"
      ></path>

      <!-- Layer 3: Stylized liquid crest stroke -->
      <path 
        d="M0,68 C180,28 320,118 560,62 C800,8 980,110 1200,52" 
        fill="none" 
        stroke="#0284C7" 
        stroke-width="2.5" 
        stroke-linecap="round"
      ></path>

      <!-- Layer 4: Accent rippling contour -->
      <path 
        d="M0,56 C180,16 320,106 560,50 C800,-4 980,98 1200,40" 
        fill="none" 
        stroke="#38BDF8" 
        stroke-width="1.5" 
        stroke-dasharray="6 6" 
        stroke-opacity="0.5"
      ></path>
    </svg>
  </div>
</section>
