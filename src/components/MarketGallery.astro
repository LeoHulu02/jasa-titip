---
import { Camera, MapPin, ZoomIn, ArrowRight, ShieldCheck, CheckCircle2 } from '@lucide/astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { marketPhotos, siteConfig, getWhatsAppUrl } from '../data/content';
---

<section id="dokumentasi" class="py-16 sm:py-20 md:py-24 bg-slate-50 border-b border-slate-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">

    <!-- Section Header -->
    <div class="flex flex-col md:flex-row md:items-end justify-between gap-6 mb-10 sm:mb-14 reveal-on-scroll">
      <div class="max-w-2xl">
        <div class="inline-flex items-center gap-2 text-xs uppercase font-bold tracking-wider text-blue-700 bg-blue-100/80 px-3 py-1 rounded-full mb-3">
          <Camera class="w-3.5 h-3.5 text-blue-600" />
          <span>Dokumentasi Lapangan Nyata</span>
        </div>
        <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight mb-3">
          Sentra Pasar Grosir yang Kami Jelajahi
        </h2>
        <p class="text-slate-600 text-sm sm:text-base leading-relaxed">
          100% foto dokumentasi autentik dari pusat-pusat perdagangan grosir Jakarta. Kami hadir langsung di toko dan gudang grosir, memastikan kualitas fisik, dan menegosiasikan harga modal terbaik untuk Anda.
        </p>
      </div>

      <!-- Quick Trust Pill -->
      <div class="flex items-center gap-2 self-start md:self-auto px-3.5 py-2 rounded-lg bg-white border border-slate-200 shadow-xs text-xs font-semibold text-slate-700 shrink-0">
        <ShieldCheck class="w-4 h-4 text-emerald-600" />
        <span>7 Sentra & Toko/Gudang Grosir Terdokumentasi</span>
      </div>
    </div>

    <!-- Mobile View: Horizontal Snap-Scroll Slider (< 768px) -->
    <div class="block md:hidden mb-8">
      <div class="flex items-center justify-between text-xs text-slate-500 mb-3 px-1 font-medium">
        <span>Geser foto untuk melihat lokasi</span>
        <span class="text-blue-600 flex items-center gap-1 font-semibold">
          7 Titik Belanja <ArrowRight class="w-3.5 h-3.5" />
        </span>
      </div>

      <!-- Horizontal Reel -->
      <div 
        id="mobile-gallery-reel"
        class="flex gap-4 overflow-x-auto snap-x snap-mandatory pb-4 -mx-4 px-4 scroll-smooth focus:outline-none"
        style="scrollbar-width: none; -ms-overflow-style: none;"
      >
        {marketPhotos.map((photo, index) => (
          <div 
            class="snap-start shrink-0 w-[82vw] max-w-[320px] bg-white rounded-xl border border-slate-200 shadow-xs overflow-hidden flex flex-col cursor-pointer group active:scale-[0.99] transition-transform"
            data-gallery-item
            data-index={index}
            data-src={photo.src}
            data-title={photo.title}
            data-location={photo.location}
            data-tag={photo.tag}
            data-desc={photo.description}
          >
            <!-- Image Frame -->
            <div class="relative aspect-[4/3] bg-slate-100 overflow-hidden">
              <img 
                src={photo.src} 
                alt={photo.title}
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
                width={photo.width}
                height={photo.height}
              />
              <div class="absolute top-2.5 left-2.5 bg-slate-900/80 backdrop-blur-xs text-white text-[11px] font-semibold px-2 py-0.5 rounded-full flex items-center gap-1 shadow-xs">
                <MapPin class="w-3 h-3 text-blue-400" />
                <span>{photo.location}</span>
              </div>
              <div class="absolute bottom-2.5 right-2.5 bg-white/90 backdrop-blur-xs text-slate-800 text-[10px] font-bold px-2 py-0.5 rounded-full shadow-xs flex items-center gap-1">
                <ZoomIn class="w-3 h-3 text-slate-600" />
                <span>Perbesar</span>
              </div>
            </div>

            <!-- Content Card -->
            <div class="p-4 flex-1 flex flex-col justify-between">
              <div>
                <span class="inline-block text-[11px] font-bold uppercase tracking-wider text-blue-700 bg-blue-50 px-2 py-0.5 rounded mb-1.5">
                  {photo.tag}
                </span>
                <h3 class="text-base font-bold text-slate-900 leading-snug mb-1.5">
                  {photo.title}
                </h3>
                <p class="text-xs text-slate-600 leading-relaxed line-clamp-2">
                  {photo.description}
                </p>
              </div>

              <div class="mt-3 pt-2.5 border-t border-slate-100 flex items-center justify-between text-xs text-blue-600 font-semibold">
                <span>Klik untuk perbesar</span>
                <span class="text-slate-400 font-mono text-[11px]">{index + 1}/7</span>
              </div>
            </div>
          </div>
        ))}
      </div>

      <!-- Mobile Scroll Indicators -->
      <div class="flex items-center justify-center gap-1.5 mt-2">
        {marketPhotos.map((_, i) => (
          <span 
            class={`h-1.5 rounded-full transition-all duration-300 ${i === 0 ? 'w-5 bg-blue-600' : 'w-1.5 bg-slate-300'}`}
            data-reel-dot={i}
          ></span>
        ))}
      </div>
    </div>

    <!-- Desktop Grid View (>= 768px) -->
    <div class="hidden md:block">
      <!-- Row 1: 3 Featured Cards -->
      <div class="grid grid-cols-12 gap-5 mb-5">
        <!-- Photo 1: Blok A (5 cols) -->
        <div 
          class="col-span-5 bg-white rounded-xl border border-slate-200 overflow-hidden shadow-xs hover:shadow-md transition-all group cursor-pointer flex flex-col reveal-on-scroll stagger-1 card-hover-lift"
          data-gallery-item
          data-index="0"
          data-src={marketPhotos[0].src}
          data-title={marketPhotos[0].title}
          data-location={marketPhotos[0].location}
          data-tag={marketPhotos[0].tag}
          data-desc={marketPhotos[0].description}
        >
          <div class="relative h-64 bg-slate-100 overflow-hidden">
            <img 
              src={marketPhotos[0].src} 
              alt={marketPhotos[0].title} 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-transparent to-transparent"></div>
            <div class="absolute top-3 left-3 bg-blue-600 text-white text-xs font-bold px-2.5 py-1 rounded-full shadow-xs">
              {marketPhotos[0].tag}
            </div>
            <div class="absolute bottom-3 left-3 right-3 text-white">
              <p class="text-xs text-slate-300 flex items-center gap-1 mb-0.5">
                <MapPin class="w-3.5 h-3.5 text-blue-400" />
                {marketPhotos[0].location}
              </p>
              <h3 class="text-base font-bold leading-tight">{marketPhotos[0].title}</h3>
            </div>
          </div>
          <div class="p-4 bg-white flex-1 flex flex-col justify-between">
            <p class="text-xs text-slate-600 leading-relaxed mb-2">
              {marketPhotos[0].description}
            </p>
            <span class="text-xs text-blue-600 font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">
              Lihat foto penuh & rincian <ArrowRight class="w-3.5 h-3.5" />
            </span>
          </div>
        </div>

        <!-- Photo 2: Toko & Gudang Busana (4 cols) -->
        <div 
          class="col-span-4 bg-white rounded-xl border border-slate-200 overflow-hidden shadow-xs hover:shadow-md transition-all group cursor-pointer flex flex-col reveal-on-scroll stagger-2 card-hover-lift"
          data-gallery-item
          data-index="1"
          data-src={marketPhotos[1].src}
          data-title={marketPhotos[1].title}
          data-location={marketPhotos[1].location}
          data-tag={marketPhotos[1].tag}
          data-desc={marketPhotos[1].description}
        >
          <div class="relative h-64 bg-slate-100 overflow-hidden">
            <img 
              src={marketPhotos[1].src} 
              alt={marketPhotos[1].title} 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-transparent to-transparent"></div>
            <div class="absolute top-3 left-3 bg-emerald-600 text-white text-xs font-bold px-2.5 py-1 rounded-full shadow-xs">
              {marketPhotos[1].tag}
            </div>
            <div class="absolute bottom-3 left-3 right-3 text-white">
              <p class="text-xs text-slate-300 flex items-center gap-1 mb-0.5">
                <MapPin class="w-3.5 h-3.5 text-emerald-400" />
                {marketPhotos[1].location}
              </p>
              <h3 class="text-base font-bold leading-tight">{marketPhotos[1].title}</h3>
            </div>
          </div>
          <div class="p-4 bg-white flex-1 flex flex-col justify-between">
            <p class="text-xs text-slate-600 leading-relaxed mb-2">
              {marketPhotos[1].description}
            </p>
            <span class="text-xs text-blue-600 font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">
              Lihat foto penuh & rincian <ArrowRight class="w-3.5 h-3.5" />
            </span>
          </div>
        </div>

        <!-- Photo 3: Suasana Atrium (3 cols) -->
        <div 
          class="col-span-3 bg-white rounded-xl border border-slate-200 overflow-hidden shadow-xs hover:shadow-md transition-all group cursor-pointer flex flex-col reveal-on-scroll stagger-3 card-hover-lift"
          data-gallery-item
          data-index="2"
          data-src={marketPhotos[2].src}
          data-title={marketPhotos[2].title}
          data-location={marketPhotos[2].location}
          data-tag={marketPhotos[2].tag}
          data-desc={marketPhotos[2].description}
        >
          <div class="relative h-64 bg-slate-100 overflow-hidden">
            <img 
              src={marketPhotos[2].src} 
              alt={marketPhotos[2].title} 
              class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
              loading="lazy"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-slate-950/70 via-transparent to-transparent"></div>
            <div class="absolute top-3 left-3 bg-indigo-600 text-white text-xs font-bold px-2.5 py-1 rounded-full shadow-xs">
              {marketPhotos[2].tag}
            </div>
            <div class="absolute bottom-3 left-3 right-3 text-white">
              <p class="text-xs text-slate-300 flex items-center gap-1 mb-0.5">
                <MapPin class="w-3.5 h-3.5 text-indigo-400" />
                {marketPhotos[2].location}
              </p>
              <h3 class="text-base font-bold leading-tight">{marketPhotos[2].title}</h3>
            </div>
          </div>
          <div class="p-4 bg-white flex-1 flex flex-col justify-between">
            <p class="text-xs text-slate-600 leading-relaxed mb-2">
              {marketPhotos[2].description}
            </p>
            <span class="text-xs text-blue-600 font-semibold inline-flex items-center gap-1 group-hover:gap-2 transition-all">
              Lihat foto penuh <ArrowRight class="w-3.5 h-3.5" />
            </span>
          </div>
        </div>
      </div>

      <!-- Row 2: 4 Grid Cards for remaining images (image-4, image-5, image-6, image-7) -->
      <div class="grid grid-cols-12 gap-5">
        {marketPhotos.slice(3).map((photo, idx) => (
          <div 
            class={`col-span-3 bg-white rounded-xl border border-slate-200 overflow-hidden shadow-xs hover:shadow-md transition-all group cursor-pointer flex flex-col reveal-on-scroll stagger-${idx + 1} card-hover-lift`}
            data-gallery-item
            data-index={idx + 3}
            data-src={photo.src}
            data-title={photo.title}
            data-location={photo.location}
            data-tag={photo.tag}
            data-desc={photo.description}
          >
            <div class="relative h-44 bg-slate-100 overflow-hidden">
              <img 
                src={photo.src} 
                alt={photo.title} 
                class="w-full h-full object-cover group-hover:scale-105 transition-transform duration-500"
                loading="lazy"
              />
              <div class="absolute inset-0 bg-gradient-to-t from-slate-950/65 via-transparent to-transparent"></div>
              <div class="absolute top-2 left-2 bg-slate-900/80 backdrop-blur-xs text-white text-[10px] font-semibold px-2 py-0.5 rounded-full flex items-center gap-1">
                <MapPin class="w-2.5 h-2.5 text-blue-400" />
                <span>{photo.location}</span>
              </div>
              <div class="absolute bottom-2 left-2 right-2 text-white">
                <h4 class="text-xs font-bold leading-snug line-clamp-1">{photo.title}</h4>
              </div>
            </div>
            <div class="p-3 bg-white flex-1 flex flex-col justify-between">
              <div>
                <span class="text-[10px] font-bold text-blue-700 bg-blue-50 px-1.5 py-0.5 rounded inline-block mb-1">
                  {photo.tag}
                </span>
                <p class="text-[11px] text-slate-600 line-clamp-2 leading-relaxed">
                  {photo.description}
                </p>
              </div>
              <div class="mt-2 pt-2 border-t border-slate-100 flex items-center justify-between text-[11px] text-blue-600 font-semibold">
                <span>Perbesar</span>
                <ZoomIn class="w-3 h-3 text-slate-400 group-hover:text-blue-600 transition-colors" />
              </div>
            </div>
          </div>
        ))}
      </div>
    </div>

    <!-- Live Proof Summary Bar -->
    <div class="mt-10 bg-white rounded-xl border border-slate-200 p-5 sm:p-6 shadow-xs flex flex-col sm:flex-row items-center justify-between gap-4 reveal-on-scroll card-hover-lift">
      <div class="flex items-center gap-3 text-left">
        <div class="w-10 h-10 rounded-full bg-emerald-50 text-emerald-600 flex items-center justify-center shrink-0">
          <CheckCircle2 class="w-5 h-5" />
        </div>
        <div>
          <h4 class="text-sm sm:text-base font-bold text-slate-900">
            Perlu Tinjau Toko atau Gudang Grosir Spesifik Hari Ini?
          </h4>
          <p class="text-xs sm:text-sm text-slate-600">
            Kirimkan foto barang, nama toko, atau info gudang grosir ke WhatsApp kami, tim lapangan kami siap meninjau langsung ke lokasi.
          </p>
        </div>
      </div>
      <a 
        href={getWhatsAppUrl('Halo Mitra Belanja, saya ingin tim lapangan meninjau toko atau gudang grosir di sentra pasar grosir.')}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-2 bg-[#25D366] hover:bg-[#1EBE5D] text-white px-5 py-2.5 rounded-lg text-xs sm:text-sm font-bold shadow-xs hover:shadow transition-all shrink-0 w-full sm:w-auto text-center wa-pulse-subtle"
      >
        <WhatsAppIcon class="w-4 h-4 text-white" />
        <span>Konsultasi Tinjau Toko/Gudang Grosir</span>
      </a>
    </div>

  </div>
</section>

<!-- Lightbox Modal (Accessible & Mobile-friendly) -->
<div 
  id="gallery-modal" 
  class="fixed inset-0 z-[70] bg-slate-950/85 backdrop-blur-sm hidden items-center justify-center p-4 transition-opacity"
  role="dialog"
  aria-modal="true"
  aria-labelledby="modal-title"
>
  <div class="relative bg-white rounded-2xl max-w-2xl w-full overflow-hidden shadow-2xl flex flex-col max-h-[92vh]">
    
    <!-- Modal Close Button -->
    <button 
      id="modal-close"
      type="button"
      class="absolute top-3 right-3 z-10 w-9 h-9 rounded-full bg-black/60 hover:bg-black text-white flex items-center justify-center transition-colors focus:outline-none focus:ring-2 focus:ring-white cursor-pointer"
      aria-label="Tutup foto"
    >
      <svg class="w-5 h-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12" />
      </svg>
    </button>

    <!-- Modal Image Container -->
    <div class="relative bg-slate-900 flex items-center justify-center overflow-hidden max-h-[58vh]">
      <img 
        id="modal-image" 
        src="" 
        alt="" 
        class="w-full h-auto max-h-[58vh] object-contain transition-all duration-300"
      />
      <div class="absolute bottom-2 left-3 bg-slate-900/80 backdrop-blur-xs text-white text-xs font-semibold px-2.5 py-1 rounded-full flex items-center gap-1.5 shadow-xs">
        <MapPin class="w-3.5 h-3.5 text-blue-400" />
        <span id="modal-location">Lokasi</span>
      </div>
    </div>

    <!-- Modal Content & CTA -->
    <div class="p-5 sm:p-6 overflow-y-auto bg-white flex flex-col gap-4">
      <div>
        <span id="modal-tag" class="text-xs font-bold uppercase tracking-wider text-blue-700 bg-blue-50 px-2.5 py-1 rounded inline-block mb-2">
          Kategori
        </span>
        <h3 id="modal-title" class="text-lg sm:text-xl font-extrabold text-slate-900 leading-snug mb-2">
          Judul Dokumentasi
        </h3>
        <p id="modal-desc" class="text-xs sm:text-sm text-slate-600 leading-relaxed">
          Deskripsi detail foto lapangan...
        </p>
      </div>

      <div class="pt-3 border-t border-slate-100 flex flex-col sm:flex-row items-stretch sm:items-center justify-between gap-3">
        <span class="text-xs text-slate-500">
          Tertarik belanja di lokasi ini? Hubungi tim lapangan kami.
        </span>
        <a 
          id="modal-wa-btn"
          href="" 
          target="_blank" 
          rel="noopener noreferrer"
          class="inline-flex items-center justify-center gap-2 bg-[#25D366] hover:bg-[#1EBE5D] text-white px-5 py-2.5 rounded-lg text-xs sm:text-sm font-bold shadow-xs hover:shadow transition-all text-center"
        >
          <WhatsAppIcon class="w-4 h-4 text-white" />
          <span>Tanyakan Belanja di Lokasi Ini</span>
        </a>
      </div>
    </div>

  </div>
</div>

<script>
  // Mobile Gallery Dot Tracker
  const reel = document.getElementById('mobile-gallery-reel');
  const dots = document.querySelectorAll('[data-reel-dot]');

  if (reel && dots.length > 0) {
    reel.addEventListener('scroll', () => {
      const scrollLeft = reel.scrollLeft;
      const cardWidth = reel.querySelector('[data-gallery-item]')?.clientWidth || 280;
      const activeIdx = Math.min(Math.round(scrollLeft / cardWidth), dots.length - 1);

      dots.forEach((dot, idx) => {
        if (idx === activeIdx) {
          dot.className = 'h-1.5 rounded-full transition-all duration-300 w-5 bg-blue-600';
        } else {
          dot.className = 'h-1.5 rounded-full transition-all duration-300 w-1.5 bg-slate-300';
        }
      });
    }, { passive: true });
  }

  // Gallery Modal Lightbox
  const modal = document.getElementById('gallery-modal');
  const modalImage = document.getElementById('modal-image') as HTMLImageElement;
  const modalTitle = document.getElementById('modal-title');
  const modalLocation = document.getElementById('modal-location');
  const modalTag = document.getElementById('modal-tag');
  const modalDesc = document.getElementById('modal-desc');
  const modalWaBtn = document.getElementById('modal-wa-btn') as HTMLAnchorElement;
  const modalClose = document.getElementById('modal-close');

  const galleryItems = document.querySelectorAll('[data-gallery-item]');

  function openModal(item: Element) {
    const src = item.getAttribute('data-src') || '';
    const title = item.getAttribute('data-title') || '';
    const location = item.getAttribute('data-location') || '';
    const tag = item.getAttribute('data-tag') || '';
    const desc = item.getAttribute('data-desc') || '';

    if (modalImage) {
      modalImage.src = src;
      modalImage.alt = title;
    }
    if (modalTitle) modalTitle.textContent = title;
    if (modalLocation) modalLocation.textContent = location;
    if (modalTag) modalTag.textContent = tag;
    if (modalDesc) modalDesc.textContent = desc;

    if (modalWaBtn) {
      const msg = `Halo Mitra Belanja, saya melihat dokumentasi "${title}" (${location}) di website dan ingin konsultasi belanja di sentra ini.`;
      modalWaBtn.href = `https://wa.me/6281320009935?text=${encodeURIComponent(msg)}`;
    }

    if (modal) {
      modal.classList.remove('hidden');
      modal.classList.add('flex');
      document.body.style.overflow = 'hidden';
    }
  }

  function closeModal() {
    if (modal) {
      modal.classList.add('hidden');
      modal.classList.remove('flex');
      document.body.style.overflow = '';
    }
  }

  galleryItems.forEach(item => {
    item.addEventListener('click', () => openModal(item));
  });

  if (modalClose) {
    modalClose.addEventListener('click', closeModal);
  }

  if (modal) {
    modal.addEventListener('click', (e) => {
      if (e.target === modal) closeModal();
    });
  }

  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && modal && !modal.classList.contains('hidden')) {
      closeModal();
    }
  });
</script>
