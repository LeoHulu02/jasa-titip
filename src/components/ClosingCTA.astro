---
import { CheckCircle2, ShieldCheck, Clock, ArrowRight } from '@lucide/astro';
import WhatsAppIcon from './WhatsAppIcon.astro';
import { siteConfig, getWhatsAppUrl } from '../data/content';

const waUrl = getWhatsAppUrl(siteConfig.closingWaMessage);
---

<section id="kontak" class="py-14 sm:py-18 md:py-22 bg-slate-900 text-white relative">
  <div class="max-w-4xl mx-auto px-4 sm:px-6 relative z-10 text-center reveal-on-scroll">
    
    <p class="text-xs font-bold uppercase tracking-wider text-emerald-400 mb-3">
      Layanan & Tim Lapangan Aktif Hari Ini
    </p>

    <h2 class="text-2xl sm:text-3xl md:text-4xl lg:text-[40px] font-extrabold tracking-[-0.025em] leading-[1.2] mb-4 text-white">
      Siap Belanja dari Pasar Grosir Jakarta?
    </h2>

    <p class="text-sm sm:text-base md:text-[17px] text-slate-300 max-w-2xl mx-auto mb-8 sm:mb-9 leading-[1.65] font-normal">
      Hubungi admin kami sekarang via WhatsApp. Cukup sebutkan barang dan sentra pasar tujuan, biarkan tim kami yang menyusuri toko atau gudang grosir dan mengurus kirimannya sampai ke tangan Anda.
    </p>

    <!-- Main WhatsApp Action Button -->
    <div class="flex flex-col sm:flex-row items-center justify-center gap-4 mb-9">
      <a 
        href={waUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-flex items-center justify-center gap-3 bg-[#25D366] hover:bg-[#1EBE5D] text-white px-8 sm:px-9 py-3.5 sm:py-4 rounded-xl font-bold text-[15px] sm:text-base shadow-md hover:shadow-lg transition-all duration-200 active:scale-95 w-full sm:w-auto group"
      >
        <WhatsAppIcon class="w-5 h-5 sm:w-6 sm:h-6 text-white group-hover:rotate-12 transition-transform" />
        <span>Mulai Chat WhatsApp Sekarang</span>
      </a>
    </div>

    <!-- Assurance Points in Crisp Surface Cards -->
    <div class="grid grid-cols-1 sm:grid-cols-3 gap-2.5 sm:gap-3 max-w-3xl mx-auto">
      <div class="p-3 sm:p-3.5 rounded-xl bg-slate-800/80 border border-slate-700/80 flex items-center justify-center gap-2 text-xs sm:text-[13px] font-medium text-white shadow-2xs">
        <CheckCircle2 class="w-4 h-4 text-emerald-400 shrink-0" />
        <span>Tanpa Biaya Pendaftaran</span>
      </div>
      <div class="p-3 sm:p-3.5 rounded-xl bg-slate-800/80 border border-slate-700/80 flex items-center justify-center gap-2 text-xs sm:text-[13px] font-medium text-white shadow-2xs">
        <CheckCircle2 class="w-4 h-4 text-emerald-400 shrink-0" />
        <span>Estimasi Biaya Jelas di Awal</span>
      </div>
      <div class="p-3 sm:p-3.5 rounded-xl bg-slate-800/80 border border-slate-700/80 flex items-center justify-center gap-2 text-xs sm:text-[13px] font-medium text-white shadow-2xs">
        <CheckCircle2 class="w-4 h-4 text-emerald-400 shrink-0" />
        <span>Nota Asli Langsung dari Toko</span>
      </div>
    </div>

  </div>
</section>
