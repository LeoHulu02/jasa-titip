---
import { ChevronDown, HelpCircle } from '@lucide/astro';
import { faqs } from '../data/content';
---

<section id="faq" class="py-16 sm:py-20 md:py-24 bg-slate-50 border-b border-slate-200">
  <div class="max-w-3xl mx-auto px-4 sm:px-6">
    
    <!-- Section Header -->
    <div class="text-center max-w-xl mx-auto mb-12 sm:mb-16">
      <span class="text-xs uppercase font-bold tracking-wider text-blue-600 bg-blue-50 border border-blue-100 px-3 py-1 rounded inline-block mb-3">
        Tanya Jawab
      </span>
      <h2 class="text-2xl sm:text-3xl md:text-4xl font-extrabold text-slate-900 tracking-tight leading-tight mb-4">
        Pertanyaan yang Sering Ditanyakan
      </h2>
      <p class="text-slate-600 text-base leading-relaxed">
        Penjelasan lengkap seputar alur kerja, tarif, dan jaminan keamanan belanja Anda.
      </p>
    </div>

    <!-- Accordion List (Semantic HTML details/summary) -->
    <div class="space-y-3.5">
      {faqs.map((faq, index) => (
        <details 
          class="group bg-white rounded-lg border border-slate-200 overflow-hidden transition-all duration-200 open:shadow-xs"
        >
          <summary 
            class="flex items-center justify-between p-4 sm:p-5 cursor-pointer list-none select-none text-left font-bold text-slate-900 group-hover:text-blue-600 transition-colors text-base sm:text-lg focus-visible:outline-none focus-visible:bg-slate-50"
          >
            <span class="flex items-center gap-3 pr-4">
              <span class="text-xs font-mono font-bold text-slate-400">0{index + 1}</span>
              <span>{faq.question}</span>
            </span>
            <ChevronDown class="w-5 h-5 text-slate-400 group-hover:text-blue-600 transition-transform duration-200 group-open:rotate-180 shrink-0" />
          </summary>
          <div class="px-4 pb-5 sm:px-5 sm:pb-6 pt-1 text-slate-600 text-sm sm:text-base leading-relaxed border-t border-slate-100">
            <p>{faq.answer}</p>
          </div>
        </details>
      ))}
    </div>

  </div>
</section>
